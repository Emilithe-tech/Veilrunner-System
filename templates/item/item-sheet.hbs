<section class="vr-item-sheet"{{#if isPhysical}} data-rarity="{{itemRarity.slug}}" data-rarity-tier="{{itemRarity.tier}}" style="--vr-item-rarity: {{itemRarity.color}};"{{/if}}>
  <header class="vr-basic-header">
    {{#if isCharacterOption}}
      <button type="button" class="vr-character-option-artwork" data-action="setCharacterOptionArtwork" title="Choose character-generation artwork" aria-label="Choose character-generation artwork">
        <img class="vr-basic-img" src="{{item.img}}" alt="" />
        <span><i class="fa-solid fa-image" aria-hidden="true"></i> Change Art</span>
      </button>
    {{else}}
      <img class="vr-basic-img" src="{{item.img}}" data-edit="img" alt="" />
    {{/if}}
    <div class="vr-basic-identity">
      <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'VEILRUNNER.Name'}}" />
    </div>
  </header>

  <nav class="vr-item-tabs vr-item-primary-tabs" aria-label="Item sheet sections">
    <button type="button" class="{{#if itemTabDetails}}active{{/if}}" data-action="setItemTab" data-tab="details" aria-pressed="{{itemTabDetails}}">
      <i class="fa-solid fa-sliders" aria-hidden="true"></i><span>Details</span>
    </button>
    <button type="button" class="{{#if itemTabDescription}}active{{/if}}" data-action="setItemTab" data-tab="description" aria-pressed="{{itemTabDescription}}">
      <i class="fa-solid fa-file-lines" aria-hidden="true"></i><span>Description</span>
    </button>
  </nav>

  {{#if itemTabDetails}}

  {{#if isGM}}
    <section class="vr-item-panel vr-item-identity">
      <h3>Identity &amp; Capabilities</h3>
      <p class="hint">Definition IDs are portable game-definition references. Foundry UUIDs and embedded Item IDs remain document and ownership references.</p>
      <div class="vr-item-field-grid">
        <label class="wide">Canonical Definition ID <input type="text" name="system.definitionId" value="{{system.definitionId}}" placeholder="veilrunner.domain.definition" /></label>
        <label class="wide">Intents <input type="text" name="system.intentsText" value="{{itemIntentsText}}" placeholder="{{itemIntents}}" /></label>
        <label class="wide">Provided Action Definition IDs <input type="text" name="system.providedActionIdsText" value="{{providedActionIdsText}}" placeholder="veilrunner.action.example" /></label>
      </div>
      {{#if itemDefinitionIdInvalid}}<p class="vr-rule-error">Definition IDs must use lowercase segments: veilrunner.domain.definition.</p>{{/if}}
    </section>
  {{/if}}

  {{#if isPhysical}}
    {{> "systems/veilrunner/templates/item/parts/physical.hbs"}}
  {{/if}}

  {{#if isQuality}}
    <section class="vr-item-panel vr-quality-authoring">
      <h3>Perk / Flaw Definition</h3>
      <div class="vr-item-field-grid">
        <label>Type
          {{#if qualityKindLocked}}<input type="text" value="{{qualityKindLabel}}" disabled />{{else}}<select name="system.kind"><option value="perk" {{#if (eq qualityKind "perk")}}selected{{/if}}>Perk</option><option value="flaw" {{#if (eq qualityKind "flaw")}}selected{{/if}}>Flaw</option></select>{{/if}}
        </label>
        <label>Tier
          <select name="system.tier">{{#each qualityTiers as |tier|}}<option value="{{tier}}" {{#if (eq ../system.tier tier)}}selected{{/if}}>{{tier}}</option>{{/each}}</select>
        </label>
        <label>Derived Cost <input type="text" value="{{qualityCost}} {{#if (eq qualityKind 'flaw')}}FP{{else}}PP{{/if}}" disabled /></label>
        <label>Pillar
          <select name="system.pillar">{{#each qualityPillars as |pillar|}}<option value="{{pillar}}" {{#if (eq ../system.pillar pillar)}}selected{{/if}}>{{pillar}}</option>{{/each}}</select>
        </label>
        <label class="wide">Card Summary <input type="text" name="system.summary" value="{{system.summary}}" /></label>
        <label class="wide">Discovery Tags <input type="text" name="system.tagsText" value="{{qualityTagsText}}" placeholder="offense, reaction, mobility" /></label>
        <label class="wide">Recommendation Tags <input type="text" name="system.recommendationTagsText" value="{{qualityRecommendationTagsText}}" placeholder="physique, soldier, reaction" /></label>
      </div>
    </section>
    <section class="vr-item-panel vr-quality-requirements">
      <h3>Requirements</h3>
      <div class="vr-item-field-grid">
        <label>Minimum Level <input type="number" name="system.requirements.minimumLevel" value="{{system.requirements.minimumLevel}}" min="0" max="50" /></label>
        <label class="wide">Required Perk / Flaw IDs <input type="text" name="system.requirements.requiredDefinitionIdsText" value="{{qualityRequiredDefinitionIdsText}}" placeholder="veilrunner.quality.example" /></label>
        <label class="wide">Required Character Tags <input type="text" name="system.requirements.requiredTagsText" value="{{qualityRequiredTagsText}}" /></label>
        <label class="wide">Player-facing Requirements <textarea name="system.requirements.text" rows="3">{{system.requirements.text}}</textarea></label>
      </div>
    </section>
    <section class="vr-item-panel vr-quality-mechanics">
      <h3>Mechanical Effects</h3>
      {{#if editable}}<prose-mirror name="system.mechanics" value="{{qualityMechanicsValue}}">{{{qualityMechanicsHTML}}}</prose-mirror>{{else}}<div class="editor-content">{{{qualityMechanicsHTML}}}</div>{{/if}}
      <p class="hint">Native Active Effects attached to this Item are also listed in the character-generation Inspector.</p>
    </section>
  {{/if}}

  {{#if isAction}}
    <label>Kind
      <select name="system.activationKind"><option value="action">Action</option><option value="ability" {{#if (eq system.activationKind "ability")}}selected{{/if}}>Ability (0 action points)</option></select>
    </label>
    <label class="vr-check">
      <input type="checkbox" name="system.favorite" {{checked system.favorite}} />
      {{localize 'VEILRUNNER.Action.FIELDS.favorite.label'}}
    </label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.actionType.label'}}
      <select name="system.actionType">
        {{#each (array "standard" "bonus" "reaction" "free") as |type|}}
          <option value="{{type}}" {{#if (eq ../system.actionType type)}}selected{{/if}}>{{localize (concat "VEILRUNNER.ActionType." type)}}</option>
        {{/each}}
      </select>
    </label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.category.label'}}
      <select name="system.category">
        {{#each (array "actions" "reactions" "magic" "tech" "weapon" "digital" "normal" "consumables" "gadgets" "item-actions" "vehicles" "pets" "spirits") as |category|}}
          <option value="{{category}}" {{#if (eq ../system.category category)}}selected{{/if}}>{{localize (concat "VEILRUNNER.ActionCategory." category)}}</option>
        {{/each}}
      </select>
    </label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.actions.label'}}
      <input type="number" name="system.actions" value="{{system.actions}}" min="0" {{#if (eq system.activationKind "ability")}}max="0"{{/if}} />
    </label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.damageType.label'}}
      <select name="system.damageType">
        <option value="">{{localize 'VEILRUNNER.None'}}</option>
        {{#each actionDamageTypes as |type|}}
          <option value="{{type}}" {{#if (eq ../system.damageType type)}}selected{{/if}}>{{localize (concat "VEILRUNNER.DamageTrait." type)}}</option>
        {{/each}}
      </select>
    </label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.maxLevel.label'}}
      <input type="number" name="system.maxLevel" value="{{system.maxLevel}}" min="1" />
    </label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.currentLevel.label'}}
      <select name="system.currentLevel">
        {{#each actionLevelOptions as |level|}}
          <option value="{{level}}" {{#if (eq ../system.currentLevel level)}}selected{{/if}}>{{level}}</option>
        {{/each}}
      </select>
    </label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.damageDice.label'}}
      <input type="number" name="system.damageDice" value="{{system.damageDice}}" min="0" />
    </label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.damageDie.label'}}
      <input type="number" name="system.damageDie" value="{{system.damageDie}}" min="2" />
    </label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.damageLevelInterval.label'}}
      <input type="number" name="system.damageLevelInterval" value="{{system.damageLevelInterval}}" min="1" />
    </label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.cost.label'}}
      <input type="text" name="system.cost" value="{{system.cost}}" />
    </label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.rollFormula.label'}}
      <input type="text" name="system.rollFormula" value="{{system.rollFormula}}" placeholder="1d10 + @attributes.physical.dexterity" />
    </label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.selector.label'}}
      <input type="text" name="system.selector" value="{{system.selector}}" placeholder="attack" />
    </label>
    <label>Governing Attribute <input type="text" name="system.governingAttribute" value="{{system.governingAttribute}}" placeholder="agility" /></label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.requiredItemTypes.label'}}
      <input type="text" name="system.requiredItemTypesText" value="{{actionRequiredItemTypesText}}" placeholder="weapon, shield" />
    </label>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.requiredItemTraits.label'}}
      <input type="text" name="system.requiredItemTraitsText" value="{{actionRequiredItemTraitsText}}" placeholder="firearm" />
    </label>
    <label>Required Definition IDs <input type="text" name="system.requiredDefinitionIdsText" value="{{actionRequiredDefinitionIdsText}}" placeholder="veilrunner.weapon.example" /></label>
    <label>Required Intents <input type="text" name="system.requiredItemIntentsText" value="{{actionRequiredItemIntentsText}}" placeholder="weapon, equippable" /></label>
    <label class="vr-check"><input type="checkbox" name="system.requiresTarget" {{checked system.requiresTarget}} /> Requires selected target</label>
    <label>Required Self Effects <input type="text" name="system.requiredEffectsText" value="{{actionRequiredEffectsText}}" placeholder="aimed, cloaked" /></label>
    <label>Required Target Effects <input type="text" name="system.requiredTargetEffectsText" value="{{actionRequiredTargetEffectsText}}" placeholder="marked, exposed" /></label>
    <label>HUD Composer Options <textarea name="system.composerText" rows="3" placeholder="Casting Rank: 1, 2, 3&#10;Range: Near, Far">{{actionComposerText}}</textarea></label>
    <details class="vr-item-advanced-contracts">
      <summary>Reactive HUD Contracts</summary>
      <fieldset><legend>Rank Scaling</legend><label class="vr-check"><input type="checkbox" name="system.rankScaling.enabled" {{checked system.rankScaling.enabled}} /> Enabled</label><label>Minimum <input type="number" name="system.rankScaling.min" min="1" value="{{system.rankScaling.min}}" /></label><label>Maximum <input type="number" name="system.rankScaling.max" min="1" max="20" value="{{system.rankScaling.max}}" /></label><label>Mana per Rank <input type="number" name="system.rankScaling.manaPerRank" min="0" value="{{system.rankScaling.manaPerRank}}" /></label><label>Stamina per Rank <input type="number" name="system.rankScaling.staminaPerRank" min="0" value="{{system.rankScaling.staminaPerRank}}" /></label><label>AP per Rank <input type="number" name="system.rankScaling.actionPerRank" min="0" value="{{system.rankScaling.actionPerRank}}" /></label></fieldset>
      <label>Requirements JSON <textarea name="system.requirementsJson" rows="5">{{actionRequirementsJson}}</textarea></label>
      <label>Effect Consumption JSON <textarea name="system.consumesJson" rows="4">{{actionConsumesJson}}</textarea></label>
      <label>Enhancements JSON <textarea name="system.enhancementsJson" rows="5">{{actionEnhancementsJson}}</textarea></label>
      <label>Augments JSON <textarea name="system.augmentsJson" rows="5">{{actionAugmentsJson}}</textarea></label>
    </details>
    <label>{{localize 'VEILRUNNER.Action.FIELDS.summary.label'}}
      <textarea name="system.summary" rows="3" placeholder="Short overview shown during character generation">{{system.summary}}</textarea>
    </label>
  {{/if}}

  {{#if isAbility}}
    <label class="vr-check">
      <input type="checkbox" name="system.featured" {{checked system.featured}} />
      {{localize 'VEILRUNNER.Ability.FIELDS.featured.label'}}
    </label>
    <label>{{localize 'VEILRUNNER.Ability.FIELDS.recharge.label'}}
      <input type="text" name="system.recharge" value="{{system.recharge}}" />
    </label>
    <label>{{localize 'VEILRUNNER.Ability.FIELDS.actions.label'}}
      <input type="number" name="system.actions" value="{{system.actions}}" min="0" max="0" />
    </label>
    <label>{{localize 'VEILRUNNER.Ability.FIELDS.damageType.label'}}
      <select name="system.damageType">
        <option value="">{{localize 'VEILRUNNER.None'}}</option>
        {{#each actionDamageTypes as |type|}}
          <option value="{{type}}" {{#if (eq ../system.damageType type)}}selected{{/if}}>{{localize (concat "VEILRUNNER.DamageTrait." type)}}</option>
        {{/each}}
      </select>
    </label>
    <label>{{localize 'VEILRUNNER.Ability.FIELDS.maxLevel.label'}}
      <input type="number" name="system.maxLevel" value="{{system.maxLevel}}" min="1" />
    </label>
    <label>{{localize 'VEILRUNNER.Ability.FIELDS.currentLevel.label'}}
      <select name="system.currentLevel">
        {{#each actionLevelOptions as |level|}}
          <option value="{{level}}" {{#if (eq ../system.currentLevel level)}}selected{{/if}}>{{level}}</option>
        {{/each}}
      </select>
    </label>
    <label>{{localize 'VEILRUNNER.Ability.FIELDS.damageDice.label'}}
      <input type="number" name="system.damageDice" value="{{system.damageDice}}" min="0" />
    </label>
    <label>{{localize 'VEILRUNNER.Ability.FIELDS.damageDie.label'}}
      <input type="number" name="system.damageDie" value="{{system.damageDie}}" min="2" />
    </label>
    <label>{{localize 'VEILRUNNER.Ability.FIELDS.damageLevelInterval.label'}}
      <input type="number" name="system.damageLevelInterval" value="{{system.damageLevelInterval}}" min="1" />
    </label>
    <label>{{localize 'VEILRUNNER.Ability.FIELDS.summary.label'}}
      <textarea name="system.summary" rows="3" placeholder="Short overview shown during character generation">{{system.summary}}</textarea>
    </label>
  {{/if}}

  {{#if isActionOrAbility}}
    <section class="vr-item-panel vr-action-tree-fields">
      <h3>Traits & Tree</h3>
      <label>Traits <input type="text" name="system.traitsText" value="{{traitsText}}" placeholder="attack, pyro, manipulate" list="vr-item-action-traits" /></label>
      <datalist id="vr-item-action-traits">{{#each actionTraits as |trait|}}<option value="{{trait.label}}"></option>{{/each}}</datalist>
      <div class="vr-item-field-grid">
        <label>School <input type="text" name="system.tree.school" value="{{system.tree.school}}" /></label>
        <label>Practice <input type="text" name="system.tree.practice" value="{{system.tree.practice}}" /></label>
        <label>Mana Cost <input type="number" name="system.resourceCosts.mana" value="{{system.resourceCosts.mana}}" min="0" /></label>
        <label>Stamina Cost <input type="number" name="system.resourceCosts.stamina" value="{{system.resourceCosts.stamina}}" min="0" /></label>
        <label>Health Cost <input type="number" name="system.resourceCosts.health" value="{{system.resourceCosts.health}}" min="0" /></label>
        <label>First Purchase TP <input type="number" name="system.tree.talentCost" value="{{system.tree.talentCost}}" min="1" /></label>
        <label>SP per Level <input type="number" name="system.tree.rankCost" value="{{system.tree.rankCost}}" min="0" /></label>
        <label>Required Level <input type="number" name="system.tree.requiredLevel" value="{{system.tree.requiredLevel}}" min="1" /></label>
      </div>
      <label class="vr-check"><input type="checkbox" name="system.tree.enabled" {{checked system.tree.enabled}} /> Include in Talents & Skills tree</label>
      <div class="vr-item-section-heading"><h4>Actor & Area Effects</h4><button type="button" class="vr-item-icon-btn" data-action="addActionEffect" title="Add effect"><i class="fa-solid fa-plus"></i></button></div>
      {{#each actionEffects as |effect|}}
        <div class="vr-action-effect-row">
          <select name="system.effects.{{@index}}.scope"><option value="actor">Actor</option><option value="area" {{#if (eq effect.scope "area")}}selected{{/if}}>Area</option></select>
          <input name="system.effects.{{@index}}.target" value="{{effect.target}}" placeholder="Target, e.g. resources.stamina.max" />
          <input name="system.effects.{{@index}}.value" value="{{effect.value}}" placeholder="Value" />
          <input name="system.effects.{{@index}}.duration" value="{{effect.duration}}" placeholder="Duration" />
          <input name="system.effects.{{@index}}.notes" value="{{effect.notes}}" placeholder="Notes" />
          <button type="button" class="vr-item-icon-btn" data-action="removeActionEffect" data-index="{{@index}}"><i class="fa-solid fa-trash"></i></button>
        </div>
      {{/each}}
    </section>
  {{/if}}

  {{#if isAccessory}}
    <div class="vr-item-layout">
      <section class="vr-item-panel">
        <h3>{{localize 'VEILRUNNER.ItemSection.core'}}</h3>
        <div class="vr-item-field-grid">
          <label class="vr-item-field">{{localize 'VEILRUNNER.AccessoryItem.FIELDS.equipmentSlot.label'}}
            <select name="system.equipmentSlot">
              {{#each (array "" "ears" "neck" "wrists" "leftRing" "rightRing") as |slot|}}
                <option value="{{slot}}" {{#if (eq ../system.equipmentSlot slot)}}selected{{/if}}>{{#if slot}}{{localize (concat "VEILRUNNER.EquipmentSlot." slot)}}{{else}}{{localize 'VEILRUNNER.None'}}{{/if}}</option>
              {{/each}}
            </select>
          </label>
          <label class="vr-item-field">{{localize 'VEILRUNNER.AccessoryItem.FIELDS.cost.label'}}
            <input type="number" name="system.cost" value="{{system.cost}}" />
          </label>
          <label class="vr-item-field">{{localize 'VEILRUNNER.AccessoryItem.FIELDS.currency.label'}}
            <input type="text" name="system.currency" value="{{system.currency}}" />
          </label>
          <label class="vr-item-field">Weight (kg)
            <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.01" />
          </label>
        </div>
      </section>
      <section class="vr-item-panel">
        <h3>{{localize 'VEILRUNNER.ItemSection.effects'}}</h3>
        <label class="vr-item-field wide">{{localize 'VEILRUNNER.AccessoryItem.FIELDS.bonuses.label'}}
          <textarea name="system.bonusesText" rows="4">{{system.bonusesText}}</textarea>
        </label>
      </section>
    </div>
  {{/if}}

  {{#if isArmor}}
    <div class="vr-item-layout">
      <section class="vr-item-panel">
        <h3>{{localize 'VEILRUNNER.ItemSection.core'}}</h3>
        <div class="vr-item-field-grid">
          <label class="vr-item-field">{{localize 'VEILRUNNER.ArmorItem.FIELDS.armorType.label'}}
            <select name="system.armorType">
              {{#each (array "light" "medium" "heavy" "shields" "greatShields") as |type|}}
                <option value="{{type}}" {{#if (eq ../system.armorType type)}}selected{{/if}}>{{localize (concat "VEILRUNNER.ArmorType." type)}}</option>
              {{/each}}
            </select>
          </label>
          <label class="vr-item-field">{{localize 'VEILRUNNER.ArmorItem.FIELDS.equipmentSlot.label'}}
            <select name="system.equipmentSlot">
              {{#each (array "" "head" "chest" "arms" "legs" "feet" "offhand") as |slot|}}
                <option value="{{slot}}" {{#if (eq ../system.equipmentSlot slot)}}selected{{/if}}>{{#if slot}}{{localize (concat "VEILRUNNER.EquipmentSlot." slot)}}{{else}}{{localize 'VEILRUNNER.None'}}{{/if}}</option>
              {{/each}}
            </select>
          </label>
          <label class="vr-item-field">{{localize 'VEILRUNNER.ArmorItem.FIELDS.itemRating.label'}}
            <input type="number" name="system.itemRating" value="{{system.itemRating}}" />
          </label>
          <label class="vr-item-field">{{localize 'VEILRUNNER.ArmorItem.FIELDS.armorClass.label'}}
            <input type="number" name="system.armorClass" value="{{system.armorClass}}" />
          </label>
          <label class="vr-item-field">{{localize 'VEILRUNNER.ArmorItem.FIELDS.cost.label'}}
            <input type="number" name="system.cost" value="{{system.cost}}" />
          </label>
          <label class="vr-item-field">{{localize 'VEILRUNNER.ArmorItem.FIELDS.currency.label'}}
            <input type="text" name="system.currency" value="{{system.currency}}" />
          </label>
          <label class="vr-item-field">Weight (kg)
            <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.01" />
          </label>
        </div>
      </section>

      <section class="vr-item-panel">
        <h3>{{localize 'VEILRUNNER.ItemSection.durability'}}</h3>
        <div class="vr-item-field-grid">
          <label class="vr-item-field">{{localize 'VEILRUNNER.ArmorItem.FIELDS.durability.label'}}
            <input type="number" name="system.durability.value" value="{{system.durability.value}}" />
          </label>
          <label class="vr-item-field">{{localize 'VEILRUNNER.ArmorItem.FIELDS.durabilityMax.label'}}
            <input type="number" name="system.durability.max" value="{{system.durability.max}}" />
          </label>
          <label class="vr-item-field">{{localize 'VEILRUNNER.ArmorItem.FIELDS.durabilityRating.label'}}
            <input type="number" name="system.durabilityRating" value="{{system.durabilityRating}}" />
          </label>
          <label class="vr-item-field">{{localize 'VEILRUNNER.ArmorItem.FIELDS.movementPenalty.label'}}
            <input type="number" name="system.movementPenalty" value="{{system.movementPenalty}}" />
          </label>
        </div>
      </section>

      <section class="vr-item-panel">
        <h3>{{localize 'VEILRUNNER.ItemSection.capacity'}}</h3>
        <div class="vr-item-field-grid">
          <label class="vr-item-field">{{localize 'VEILRUNNER.ArmorItem.FIELDS.capacityMode.label'}}
            <select name="system.capacity.mode">
              {{#each (array "armor" "shield") as |mode|}}
                <option value="{{mode}}" {{#if (eq ../system.capacity.mode mode)}}selected{{/if}}>{{localize (concat "VEILRUNNER.CapacityMode." mode)}}</option>
              {{/each}}
            </select>
          </label>
          <label class="vr-item-field">{{localize 'VEILRUNNER.ArmorItem.FIELDS.armorCapacity.label'}}
            <input type="number" name="system.capacity.armor" value="{{system.capacity.armor}}" />
          </label>
          <label class="vr-item-field">{{localize 'VEILRUNNER.ArmorItem.FIELDS.shieldCapacity.label'}}
            <input type="number" name="system.capacity.shield" value="{{system.capacity.shield}}" />
          </label>
        </div>
      </section>

      <section class="vr-item-panel">
        <h3>{{localize 'VEILRUNNER.ItemSection.effects'}}</h3>
        <div class="vr-armor-effects">
          <div class="vr-armor-effect-group">
            <div class="vr-armor-effect-heading">
              <span>{{localize 'VEILRUNNER.ArmorItem.FIELDS.resistances.label'}}</span>
              <button type="button" class="vr-item-icon-btn" data-action="addArmorEntry" data-path="resistances" title="{{localize 'VEILRUNNER.Add'}}" aria-label="{{localize 'VEILRUNNER.Add'}}"><i class="fa-solid fa-plus"></i></button>
            </div>
            {{#each armorResistances as |entry|}}
              <div class="vr-armor-trait-row">
                <select name="system.resistances.{{@index}}.trait">
                  <option value="">{{localize 'VEILRUNNER.None'}}</option>
                  {{#each ../armorTraits as |trait|}}
                    <option value="{{trait}}" {{#if (eq entry.trait trait)}}selected{{/if}}>{{localize (concat "VEILRUNNER.DamageTrait." trait)}}</option>
                  {{/each}}
                </select>
                <input type="number" name="system.resistances.{{@index}}.level" value="{{entry.level}}" min="0" />
                <button type="button" class="vr-item-icon-btn" data-action="removeArmorEntry" data-path="resistances" data-index="{{@index}}" title="{{localize 'VEILRUNNER.Remove'}}" aria-label="{{localize 'VEILRUNNER.Remove'}}" {{#if entry.isEmpty}}disabled{{/if}}><i class="fa-solid fa-minus"></i></button>
              </div>
            {{/each}}
          </div>
          <div class="vr-armor-effect-group">
            <div class="vr-armor-effect-heading">
              <span>{{localize 'VEILRUNNER.ArmorItem.FIELDS.weaknesses.label'}}</span>
              <button type="button" class="vr-item-icon-btn" data-action="addArmorEntry" data-path="weaknesses" title="{{localize 'VEILRUNNER.Add'}}" aria-label="{{localize 'VEILRUNNER.Add'}}"><i class="fa-solid fa-plus"></i></button>
            </div>
            {{#each armorWeaknesses as |entry|}}
              <div class="vr-armor-trait-row">
                <select name="system.weaknesses.{{@index}}.trait">
                  <option value="">{{localize 'VEILRUNNER.None'}}</option>
                  {{#each ../armorTraits as |trait|}}
                    <option value="{{trait}}" {{#if (eq entry.trait trait)}}selected{{/if}}>{{localize (concat "VEILRUNNER.DamageTrait." trait)}}</option>
                  {{/each}}
                </select>
                <input type="number" name="system.weaknesses.{{@index}}.level" value="{{entry.level}}" min="0" />
                <button type="button" class="vr-item-icon-btn" data-action="removeArmorEntry" data-path="weaknesses" data-index="{{@index}}" title="{{localize 'VEILRUNNER.Remove'}}" aria-label="{{localize 'VEILRUNNER.Remove'}}" {{#if entry.isEmpty}}disabled{{/if}}><i class="fa-solid fa-minus"></i></button>
              </div>
            {{/each}}
          </div>
          <div class="vr-armor-effect-group wide">
            <div class="vr-armor-effect-heading">
              <span>{{localize 'VEILRUNNER.ArmorItem.FIELDS.effects.label'}}</span>
              <button type="button" class="vr-item-icon-btn" data-action="addArmorEntry" data-path="effects" title="{{localize 'VEILRUNNER.Add'}}" aria-label="{{localize 'VEILRUNNER.Add'}}"><i class="fa-solid fa-plus"></i></button>
            </div>
            {{#each armorEffects as |effect|}}
              <div class="vr-armor-effect-row">
                <select name="system.effects.{{@index}}.targetType">
                  {{#each ../armorEffectTargets as |targetType|}}
                    <option value="{{targetType}}" {{#if (eq effect.targetType targetType)}}selected{{/if}}>{{localize (concat "VEILRUNNER.EffectTarget." targetType)}}</option>
                  {{/each}}
                </select>
                <input type="text" name="system.effects.{{@index}}.target" value="{{effect.target}}" placeholder="{{localize 'VEILRUNNER.ArmorEffectTarget'}}" />
                <input type="number" name="system.effects.{{@index}}.value" value="{{effect.value}}" />
                <input type="text" name="system.effects.{{@index}}.notes" value="{{effect.notes}}" placeholder="{{localize 'VEILRUNNER.Notes'}}" />
                <button type="button" class="vr-item-icon-btn" data-action="removeArmorEntry" data-path="effects" data-index="{{@index}}" title="{{localize 'VEILRUNNER.Remove'}}" aria-label="{{localize 'VEILRUNNER.Remove'}}" {{#if effect.isEmpty}}disabled{{/if}}><i class="fa-solid fa-minus"></i></button>
              </div>
            {{/each}}
          </div>
        </div>
      </section>

    </div>
  {{/if}}

  {{#if isArchetype}}
    <label>{{localize 'VEILRUNNER.ArchetypeItem.FIELDS.summary.label'}}
      <input type="text" name="system.summary" value="{{system.summary}}" />
    </label>
  {{/if}}

  {{#if isProfession}}
    <label>{{localize 'VEILRUNNER.ProfessionItem.FIELDS.archetypeId.label'}}
      <input type="text" name="system.archetypeId" value="{{system.archetypeId}}" placeholder="veilrunner.archetype.physique" />
    </label>
    <label>{{localize 'VEILRUNNER.ProfessionItem.FIELDS.archetype.label'}}
      <input type="text" name="system.archetype" value="{{system.archetype}}" />
    </label>
    <label>{{localize 'VEILRUNNER.ProfessionItem.FIELDS.summary.label'}}
      <input type="text" name="system.summary" value="{{system.summary}}" />
    </label>
    <label>{{localize 'VEILRUNNER.ProfessionItem.FIELDS.pageImage.label'}}
      <input type="text" name="system.pageImage" value="{{system.pageImage}}" />
    </label>
  {{/if}}

  {{#if isDiscipline}}
    <label>{{localize 'VEILRUNNER.DisciplineItem.FIELDS.professionId.label'}}
      <input type="text" name="system.professionId" value="{{system.professionId}}" placeholder="veilrunner.profession.gymnast" />
    </label>
    <label>{{localize 'VEILRUNNER.DisciplineItem.FIELDS.profession.label'}}
      <input type="text" name="system.profession" value="{{system.profession}}" />
    </label>
    <label>{{localize 'VEILRUNNER.DisciplineItem.FIELDS.summary.label'}}
      <input type="text" name="system.summary" value="{{system.summary}}" />
    </label>
    <label>{{localize 'VEILRUNNER.DisciplineItem.FIELDS.quote.label'}}
      <input type="text" name="system.quote" value="{{system.quote}}" />
    </label>
    <label>{{localize 'VEILRUNNER.DisciplineItem.FIELDS.primaryWeapon.label'}}
      <input type="text" name="system.primaryWeapon" value="{{system.primaryWeapon}}" />
    </label>
    <label>{{localize 'VEILRUNNER.DisciplineItem.FIELDS.primaryAttributes.label'}}
      <input type="text" name="system.primaryAttributes" value="{{primaryAttributesText}}" />
    </label>
    <label>{{localize 'VEILRUNNER.DisciplineItem.FIELDS.bonusAttributes.label'}}
      <input type="text" name="system.bonusAttributes" value="{{bonusAttributesText}}" />
    </label>
    <label>{{localize 'VEILRUNNER.DisciplineItem.FIELDS.bonusSkill.label'}}
      <input type="text" name="system.bonusSkill" value="{{system.bonusSkill}}" />
    </label>
    <label>{{localize 'VEILRUNNER.DisciplineItem.FIELDS.tags.label'}}
      <input type="text" name="system.tagsText" value="{{disciplineTagsText}}" placeholder="mobility, utility" />
    </label>
    <label>{{localize 'VEILRUNNER.DisciplineItem.FIELDS.source.label'}}
      <input type="text" name="system.source" value="{{system.source}}" />
    </label>
    <label>{{localize 'VEILRUNNER.DisciplineItem.FIELDS.sourcePage.label'}}
      <input type="text" name="system.sourcePage" value="{{system.sourcePage}}" />
    </label>
    <label>{{localize 'VEILRUNNER.DisciplineItem.FIELDS.pageImage.label'}}
      <input type="text" name="system.pageImage" value="{{system.pageImage}}" />
    </label>
    <label>{{localize 'VEILRUNNER.DisciplineItem.FIELDS.abilities.label'}}
      <textarea name="system.abilitiesJson" rows="8">{{disciplineAbilitiesJson}}</textarea>
    </label>
  {{/if}}

  {{#if isTreasure}}
    <label>{{localize 'VEILRUNNER.Treasure.FIELDS.category.label'}}
      <select name="system.category">
        {{#each (array "weapon" "ammo" "armor" "consumable" "tech" "keyItem" "junk") as |category|}}
          <option value="{{category}}" {{#if (eq ../system.category category)}}selected{{/if}}>{{localize (concat "VEILRUNNER.InventoryCategory." category)}}</option>
        {{/each}}
      </select>
    </label>
    {{#if (eq system.category "weapon")}}
      <label>{{localize 'VEILRUNNER.Treasure.FIELDS.weaponType.label'}}
        <select name="system.weaponType">
          <option value="">{{localize 'VEILRUNNER.WeaponFilter.allWeapons'}}</option>
          {{#each weaponTypeGroups as |group|}}
            <optgroup label="{{localize (concat 'VEILRUNNER.WeaponFilter.' group.key)}}">
              {{#each group.types as |weaponType|}}
                <option value="{{weaponType}}" {{#if (eq ../../system.weaponType weaponType)}}selected{{/if}}>{{localize (concat "VEILRUNNER.WeaponFilter." weaponType)}}</option>
              {{/each}}
            </optgroup>
          {{/each}}
        </select>
      </label>
    {{/if}}
    <label>{{localize 'VEILRUNNER.Treasure.FIELDS.quantity.label'}}
      <input type="number" name="system.quantity" value="{{system.quantity}}" />
    </label>
    <label>Weight (kg)
      <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.01" />
    </label>
    <label>{{localize 'VEILRUNNER.Treasure.FIELDS.price.label'}}
      <input type="number" name="system.price" value="{{system.price}}" />
    </label>
    <label>{{localize 'VEILRUNNER.Treasure.FIELDS.rarity.label'}}
      <input type="text" name="system.rarity" value="{{system.rarity}}" />
    </label>
    <label class="vr-check">
      <input type="checkbox" name="system.identified" {{checked system.identified}} />
      {{localize 'VEILRUNNER.Treasure.FIELDS.identified.label'}}
    </label>
  {{/if}}

  {{#if isCharacterOption}}
    <p class="hint vr-character-option-art-hint">The selected Item artwork fills this option's card in character generation.</p>
  {{/if}}
  {{#if isPersonaCharacterOption}}
    <label>{{localize 'VEILRUNNER.PersonaIndex'}}
      <input type="text" name="system.persona" value="{{personaText}}" placeholder="+5 Lawful, +5 Empathy" />
    </label>
  {{/if}}
  {{/if}}

  {{#if itemTabDescription}}
    <section class="vr-item-panel vr-item-description-panel">
      <header class="vr-item-description-heading">
        <div><span>Item Description</span><h3>Description</h3></div>
        <p>Author the player-facing information used by character generation and other Item displays.</p>
      </header>
      {{#if editable}}
        <prose-mirror class="vr-item-description-editor" name="{{descriptionPath}}" value="{{descriptionValue}}">
          {{{descriptionHTML}}}
        </prose-mirror>
      {{else}}
        <div class="editor-content vr-item-description-readonly">{{{descriptionHTML}}}</div>
      {{/if}}

      {{#if hasGMDescription}}
        <div class="vr-item-gm-description">
          <label class="vr-item-editor-label">{{localize 'VEILRUNNER.GMNotes'}}</label>
          {{#if editable}}
            <prose-mirror class="vr-item-description-editor" name="system.description.gm" value="{{gmDescriptionValue}}">
              {{{gmDescriptionHTML}}}
            </prose-mirror>
          {{else}}
            <div class="editor-content vr-item-description-readonly">{{{gmDescriptionHTML}}}</div>
          {{/if}}
        </div>
      {{/if}}
    </section>
  {{/if}}
</section>
