<fieldset class="vr-item-details" {{#unless editable}}disabled{{/unless}}>
  {{#if editable}}<section class="vr-item-panel"><h2 class="section-heading">Identity</h2><label class="vr-item-field"><span>Name</span><input name="name" value="{{item.name}}" type="text" /></label><label class="vr-item-field"><span>Summary</span><textarea name="system.summary" rows="2">{{system.summary}}</textarea></label></section>{{/if}}
  {{#each details}}<section class="vr-item-panel"><h2 class="section-heading">{{label}}</h2><div class="vr-item-detail-fields">{{#each fields}}{{> "systems/veilrunner/templates/item/parts/field.hbs"}}{{/each}}</div></section>{{/each}}
  {{#if editable}}<section class="vr-item-panel"><h2 class="section-heading">Usage & notes</h2><prose-mirror name="system.mechanics" value="{{system.mechanics}}">{{{mechanicsHTML}}}</prose-mirror></section>{{/if}}
  {{#if isGM}}{{#if physical}}{{#if editable}}<details class="vr-item-panel"><summary>GM notes</summary><prose-mirror name="system.description.gm" value="{{system.description.gm}}">{{{gmDescriptionHTML}}}</prose-mirror></details>{{else}}{{#if system.description.gm}}<details class="vr-item-panel"><summary>GM notes</summary><div class="vr-item-prose">{{{gmDescriptionHTML}}}</div></details>{{/if}}{{/if}}{{/if}}{{/if}}
</fieldset>
{{#if editable}}<details class="vr-item-panel"><summary>Definition references</summary><p class="vr-item-hint">Load named choices from one library type when editing a reference.</p><div class="vr-item-reference-picker"><select data-reference-type aria-label="Definition type">{{#each definitionTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select><button type="button" data-sheet-action="loadDefinitions">Load choices</button></div></details>{{/if}}
{{#if system.definitionId}}<dl class="vr-item-metadata"><dt>Definition</dt><dd>{{system.definitionId}}</dd></dl>{{/if}}
