{"_id":"c9e744b99665cb89","name":"Resplendent Flora","type":"ability","img":"icons/svg/upgrade.svg","system":{"definitionId":"veilrunner.unique-abilities.druid.cultivator.resplendent-flora","intents":["action-provider"],"providedActionIds":[],"featured":false,"category":"actions","actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"recharge":"","summary":"","description":"<p>When flora is available, gain +10 to attack rolls for floral abilities and spells, plus 1d6 floral damage for every five character levels. Once per long rest.</p>","traits":["ability"]},"effects":[],"folder":null,"sort":600000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Druid","discipline":"Cultivator","sourceAbilityName":"Resplendent Flora","sourceType":"Ability","rulesText":"When flora is available, gain +10 to attack rolls for floral abilities and spells, plus 1d6 floral damage for every five character levels. Once per long rest."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"d54dcee1860843cb","name":"Expanded Synergy","type":"ability","img":"icons/svg/upgrade.svg","system":{"definitionId":"veilrunner.unique-abilities.amplifier.synergist.expanded-synergy","intents":["action-provider"],"providedActionIds":[],"featured":false,"category":"actions","actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"recharge":"","summary":"","description":"<p>When casting a spell with the buff trait on an ally, also apply it to yourself or another ally at half mana cost rounded up. Three uses per Field Recovery.</p>","traits":["ability"]},"effects":[],"folder":null,"sort":400000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Amplifier","discipline":"Synergist","sourceAbilityName":"Expanded Synergy","sourceType":"Ability","rulesText":"When casting a spell with the buff trait on an ally, also apply it to yourself or another ally at half mana cost rounded up. Three uses per Field Recovery."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
