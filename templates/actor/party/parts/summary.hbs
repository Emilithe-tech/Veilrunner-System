<div class="vr-party-v2-summary{{#if legacy}} vr-party-v2-summary-legacy{{/if}}">
  <div><span class="vr-party-v2-inventory-value" data-short-label="{{localize 'VEILRUNNER.InventoryValueShort'}}" data-full-label="{{localize 'VEILRUNNER.InventoryValue'}}" aria-label="{{localize 'VEILRUNNER.InventoryValue'}}"></span><strong><i class="fa-solid fa-sim-card"></i> {{partyOverview.totalInventoryValue}}</strong></div>
  <div><span>{{localize 'VEILRUNNER.Wealth'}}</span><strong title="Galactic Federation Credits"><i class="fa-solid fa-sim-card"></i> {{partyOverview.totalCurrencyValue}}</strong></div>
  <div><span>{{localize 'VEILRUNNER.TotalWealth'}}</span><strong><i class="fa-solid fa-sim-card"></i> {{partyOverview.totalWealth}}</strong></div>
</div>
