# Keep project text files consistent across Windows and other platforms.
.gitattributes text eol=lf
.gitignore     text eol=lf
*.css  text eol=lf
*.hbs  text eol=lf
*.html text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.mjs  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# LevelDB and database artifacts are binary and must never be normalized or
# subjected to text whitespace checks.
packs/** binary
*.db     binary
*.ldb    binary
*.log    binary
