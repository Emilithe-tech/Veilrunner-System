{"_id":"G4IZykOPpQ81Osk9","name":"Duelist - Assassin","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Armament","profession":"Duelist","discipline":"Assassin","quote":"","primaryWeapon":"Short Blades","primaryAttributes":["Dexterity","Reaction"],"bonusAttributes":["Dexterity","Reaction"],"bonusSkill":"Disarm","persona":["Individual","Ruthless"],"pageImage":"assets/img/professions/duelist.png","sourcePage":"7","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/duelist.png\" alt=\"Duelist - Assassin PDF page 7\" /></figure>"},"effects":[],"folder":null,"sort":900000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Duelists are blade masters, often hired for clean work by megacorps and fixers.","disciplineSummary":"A melee combatant who exploits weak targets and deals heavy damage to badly injured enemies.","abilities":[{"name":"Assassinate","type":"Action >>","text":"With a short blade, strike a badly injured target with no active armor, shields, or barrier. Outcomes scale from contested state to triple critical damage. Three uses per long rest."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
