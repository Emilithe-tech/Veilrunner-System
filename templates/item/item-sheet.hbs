<section class="vr-item-sheet">
  <aside class="vr-item-rail" aria-label="Item overview">
    <div class="vr-item-artwork">
      <img src="{{item.img}}" alt="{{item.name}}" />
      {{#if editable}}<button type="button" data-sheet-action="artwork" aria-label="Change artwork" title="Change artwork"><i class="fa-solid fa-image" aria-hidden="true"></i></button>{{/if}}
    </div>
    {{#if overview.core.length}}<section class="vr-item-panel"><h2 class="section-heading"><i class="fa-solid fa-gauge" aria-hidden="true"></i>Core stats</h2>{{> "systems/veilrunner/templates/item/parts/rows.hbs" rows=overview.core}}</section>{{/if}}
    {{#if overview.requirements.length}}<section class="vr-item-panel"><h2 class="section-heading"><i class="fa-solid fa-lock" aria-hidden="true"></i>Requirements</h2>{{> "systems/veilrunner/templates/item/parts/rows.hbs" rows=overview.requirements}}</section>{{/if}}
    {{#if overview.traits.length}}<section class="vr-item-panel"><h2 class="section-heading"><i class="fa-solid fa-layer-group" aria-hidden="true"></i>Traits</h2><ul class="vr-item-traits">{{#each overview.traits}}<li>{{this}}</li>{{/each}}</ul></section>{{/if}}
    {{#if overview.summary}}<section class="vr-item-panel vr-item-flavor"><p>{{overview.summary}}</p></section>{{/if}}
  </aside>
  <main class="vr-item-main">
    <header class="vr-item-identity">
      <div class="vr-item-name">
        <h1>{{overview.header.name}}</h1>
        {{#if overview.header.subtype}}<p class="vr-item-subtype">{{overview.header.subtype}}</p>{{/if}}
        <span class="vr-item-type">{{overview.header.type}}</span>
      </div>
      {{#if overview.header.grade}}<div class="vr-item-grade-panel"><div><span>{{overview.header.gradeLabel}}</span><strong>{{overview.header.grade}}</strong></div>{{#if overview.header.rarity}}<div class="vr-item-rarity"><span>Rarity</span><b>{{overview.header.rarity}}</b></div>{{/if}}</div>{{else}}{{#if overview.header.rarity}}<div class="vr-item-grade-panel"><div class="vr-item-rarity"><span>Rarity</span><b>{{overview.header.rarity}}</b></div></div>{{/if}}{{/if}}
    </header>
    <nav class="vr-item-tabs" aria-label="Item sheet sections" role="tablist">
      {{#each tabs}}<button type="button" class="bottom-nav-btn {{#if active}}active{{/if}}" data-item-tab="{{id}}" role="tab" aria-selected="{{active}}" aria-controls="{{@root.id}}-item-content"><i class="fa-solid {{icon}}" aria-hidden="true"></i><span>{{label}}</span></button>{{/each}}
    </nav>
    <div class="vr-item-content" id="{{id}}-item-content" role="tabpanel" aria-label="Item {{#if tabSummary}}summary{{else}}{{#if tabActions}}actions{{else}}{{#if tabConfiguration}}configuration{{else}}details{{/if}}{{/if}}{{/if}}">
      {{#if tabSummary}}{{> "systems/veilrunner/templates/item/parts/summary.hbs"}}{{/if}}
      {{#if tabActions}}{{> "systems/veilrunner/templates/item/parts/actions.hbs"}}{{/if}}
      {{#if tabConfiguration}}{{> "systems/veilrunner/templates/item/parts/configuration.hbs"}}{{/if}}
      {{#if tabDetails}}{{> "systems/veilrunner/templates/item/parts/details.hbs"}}{{/if}}
    </div>
  </main>
</section>
