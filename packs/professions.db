{"_id":"SE369pczQJi7lTp0","name":"Conjurer - Illusionist","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Magic","profession":"Conjurer","discipline":"Illusionist","quote":"","primaryWeapon":"Light Firearms","primaryAttributes":["Intelligence","Focus"],"bonusAttributes":["Agility","Intelligence"],"bonusSkill":"Conjure Illusion","persona":["Individual","Criminal"],"pageImage":"assets/img/professions/conjurer.png","sourcePage":"14","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/conjurer.png\" alt=\"Conjurer - Illusionist PDF page 14\" /></figure>"},"effects":[],"folder":null,"sort":2400000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Conjurers call spirits, illusions, phantasms, and other willing entities into reality.","disciplineSummary":"A caster who creates illusions and phantasms to misdirect, frighten, and influence enemies.","abilities":[{"name":"Signature Illusions","type":"Trait","text":"Choose a favored illusion type. Gain +2 to Illusion rolls with that type, and extend duration by +1 round for every ten character levels."},{"name":"Unnerved","type":"Trait","text":"Gain +1 to Willpower or Perception saves against illusions for every five character levels."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
