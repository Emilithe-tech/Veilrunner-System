<div class="vr-party-v2-card">
  <div class="vr-party-v2-inventory-controls">
    <label class="vr-party-v2-inventory-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" placeholder="{{localize 'VEILRUNNER.SearchInventory'}}" aria-label="{{localize 'VEILRUNNER.SearchInventory'}}"></label>
    <label class="vr-party-v2-inventory-filter"><span>{{localize 'VEILRUNNER.InventoryCategory.label'}}</span><select aria-label="{{localize 'VEILRUNNER.InventoryCategory.label'}}"><option value="all" {{#if (eq partyInventoryCategory "all")}}selected{{/if}}>{{localize 'VEILRUNNER.InventoryCategory.all'}}</option><option value="weapon" {{#if (eq partyInventoryCategory "weapon")}}selected{{/if}}>{{localize 'VEILRUNNER.InventoryCategory.weapon'}}</option><option value="ammo" {{#if (eq partyInventoryCategory "ammo")}}selected{{/if}}>{{localize 'VEILRUNNER.InventoryCategory.ammo'}}</option><option value="armor" {{#if (eq partyInventoryCategory "armor")}}selected{{/if}}>{{localize 'VEILRUNNER.InventoryCategory.armor'}}</option><option value="equipment" {{#if (eq partyInventoryCategory "equipment")}}selected{{/if}}>{{localize 'VEILRUNNER.InventoryCategory.equipment'}}</option><option value="consumable" {{#if (eq partyInventoryCategory "consumable")}}selected{{/if}}>{{localize 'VEILRUNNER.InventoryCategory.consumable'}}</option><option value="tech" {{#if (eq partyInventoryCategory "tech")}}selected{{/if}}>{{localize 'VEILRUNNER.InventoryCategory.tech'}}</option><option value="keyItem" {{#if (eq partyInventoryCategory "keyItem")}}selected{{/if}}>{{localize 'VEILRUNNER.InventoryCategory.keyItem'}}</option><option value="junk" {{#if (eq partyInventoryCategory "junk")}}selected{{/if}}>{{localize 'VEILRUNNER.InventoryCategory.junk'}}</option><option value="other" {{#if (eq partyInventoryCategory "other")}}selected{{/if}}>{{localize 'VEILRUNNER.InventoryCategory.other'}}</option></select></label>
  </div>
  <div class="vr-party-v2-list-head vr-party-v2-inventory-head"><span>Item</span><span>Qty</span><span>Value</span></div>
  <div class="vr-party-v2-scroll-list">{{#each partyOverview.inventory as |item|}}{{> "systems/veilrunner/templates/actor/party/parts/inventory-row.hbs" item}}{{else}}<p class="empty-row">{{localize 'VEILRUNNER.NoStashItems'}}</p>{{/each}}</div>
</div>
