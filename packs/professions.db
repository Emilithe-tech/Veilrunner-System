{"_id":"WAQKyYEJkjNFpf1v","name":"Cleric - Priest","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Magic","profession":"Cleric","discipline":"Priest","quote":"","primaryWeapon":"Staff","primaryAttributes":["Willpower","Focus"],"bonusAttributes":["Intelligence","Willpower"],"bonusSkill":"Healing Touch","persona":["Collectivist","Empathetic"],"pageImage":"assets/img/professions/cleric.png","sourcePage":"13","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/cleric.png\" alt=\"Cleric - Priest PDF page 13\" /></figure>"},"effects":[],"folder":null,"sort":2100000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Clerics are devout religious advocates who heal, defend, spread faith, and sometimes enforce doctrine.","disciplineSummary":"A holy support caster focused on healing allies and damaging undead with vitality.","abilities":[{"name":"Pray","type":"Sustained Action >>","text":"Chant in prayer, consuming 10 stamina each combat round. Heal creatures within 10m for 2d8 + Willpower HP at the end of your turn; undead instead take vitality damage with a Willpower save."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
{"_id":"acOBhkBVkPOMhIr7","name":"Conjurer - Summoner","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Magic","profession":"Conjurer","discipline":"Summoner","quote":"","primaryWeapon":"Foci","primaryAttributes":["Willpower","Focus"],"bonusAttributes":["Intelligence","Willpower"],"bonusSkill":"Summon Eidolon","persona":["Individual","Criminal"],"pageImage":"assets/img/professions/conjurer.png","sourcePage":"14","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/conjurer.png\" alt=\"Conjurer - Summoner PDF page 14\" /></figure>"},"effects":[],"folder":null,"sort":2300000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Conjurers call spirits, illusions, phantasms, and other willing entities into reality.","disciplineSummary":"A spirit caller who summons beings for tasks, reconnaissance, and combat assistance.","abilities":[{"name":"Established Connection","type":"Trait","text":"When summoning a spirit, gain +1 to the summoning roll for every five character levels."},{"name":"Innate Connection","type":"Trait","text":"Reduce the number of actions required to summon a spirit by one."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
{"_id":"bhFDEKPcvMckCiKy","name":"Druid - Shapeshifter","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Magic","profession":"Druid","discipline":"Shapeshifter","quote":"","primaryWeapon":"Animal Forms","primaryAttributes":["Willpower","Strength"],"bonusAttributes":["Dexterity","Willpower"],"bonusSkill":"Fauna Speak","persona":["Individual","Criminal"],"pageImage":"assets/img/professions/druid.png","sourcePage":"15","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/druid.png\" alt=\"Druid - Shapeshifter PDF page 15\" /></figure>"},"effects":[],"folder":null,"sort":2500000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Druids commune with nature and stabilize Aether disrupted by corporations and reckless magic users.","disciplineSummary":"A fauna-form specialist who attacks, intimidates, communicates, and navigates as animals.","abilities":[{"name":"Commune with Fauna","type":"Trait","text":"Communicate with fauna as if speaking your native language, limited by your current form."},{"name":"Hastened Shapeshifting","type":"Trait","text":"When shifting into animal form, roll 1d6 and reduce the action point cost by the result."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
{"_id":"c64VC19RksjB6QQR","name":"Berserker - Reaver","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Physique","profession":"Berserker","discipline":"Reaver","quote":"","primaryWeapon":"Great Sword","primaryAttributes":["Strength","Willpower"],"bonusAttributes":["Strength","Reaction"],"bonusSkill":"Toughness","persona":["Ruthless","Individual"],"pageImage":"assets/img/professions/berserker.png","sourcePage":"3","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/berserker.png\" alt=\"Berserker - Reaver PDF page 3\" /></figure>"},"effects":[],"folder":null,"sort":200000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Berserkers harness innate bodily energy and push beyond normal mortal limits. They excel in close quarters and deliver powerful strikes.","disciplineSummary":"A martial combatant that turns damage taken into stamina and uses pain to fuel stronger fighting.","abilities":[{"name":"Bleeding Endurance","type":"Trait","text":"When taking physical damage, convert 10% of damage taken to stamina, or 20% while below half health. Resisted damage is not converted."},{"name":"Last Stand","type":"Reaction","text":"Gain temporary HP equal to 20% of maximum HP until the end of your next turn when facing a killing blow. If you defeat a target before then, the temporary HP becomes normal HP. Once per long rest."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
{"_id":"dKQgl1txZBEs4ans","name":"Elemental Adept - Aqueous Adept","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Magic","profession":"Elemental Adept","discipline":"Aqueous Adept","quote":"","primaryWeapon":"Hydro Magic","primaryAttributes":["Intelligence","Dexterity"],"bonusAttributes":["Agility","Intelligence"],"bonusSkill":"Reading of Water","persona":["Empathetic","Collectivist"],"pageImage":"assets/img/professions/elemental-adept.png","sourcePage":"16","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/elemental-adept.png\" alt=\"Elemental Adept - Aqueous Adept PDF page 16\" /></figure>"},"effects":[],"folder":null,"sort":2800000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Elemental Adepts train in schools of elemental magic to alter reality through water, earth, fire, air, steel, or all elements.","disciplineSummary":"A hydromancer who changes the flow and shape of water-based liquids.","abilities":[{"name":"Hydro Affinity","type":"Trait","text":"Hydro spells gain +5 to attack rolls, +1 more every 10 levels, and +1d8 damage at level 5 and every 5 levels thereafter."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
