<section class="main-panel" style="--vr-accent: {{sheetOptions.categoryHighlightColor}}; --vr-pan-off: {{sheetOptions.panOffColor}}; --vr-pan-on: {{sheetOptions.panOnColor}}; --vr-pan-interference: {{sheetOptions.panInterferenceColor}}; --vr-character-border: {{sheetOptions.characterBorderColor}}; --vr-character-background: {{#if sheetOptions.characterBackgroundColorEnabled}}{{sheetOptions.characterBackgroundColor}}{{else}}transparent{{/if}};{{#if characterBackgroundImage}} --vr-character-background-image: url('{{characterBackgroundImage}}');{{/if}} --vr-mana-text: {{sheetOptions.manaTextColor}}; --vr-stamina-text: {{sheetOptions.staminaTextColor}}; --vr-level-up: {{sheetOptions.levelUpColor}}; --vr-earned-xp: {{sheetOptions.earnedXpColor}}; --vr-total-xp: {{sheetOptions.totalXpColor}}; --vr-level-up-glow: {{sheetOptions.levelUpGlowColor}}; --vr-level-brightness: {{sheetOptions.levelUpBrightness}}; --vr-level-intensity: {{sheetOptions.levelUpGlowIntensity}}; --vr-level-rate-duration: {{sheetOptions.levelUpRateDuration}}s;">
  {{> "systems/veilrunner/templates/actor/hero/parts/drawer-handles.hbs"}}
  <div class="hero-row {{#if sheetOptions.hideHeroColumn}}hero-column-hidden{{/if}}">
    <div class="hero-column">
{{> "systems/veilrunner/templates/actor/hero/parts/identity.hbs"}}
{{> "systems/veilrunner/templates/actor/hero/parts/portrait.hbs"}}

{{> "systems/veilrunner/templates/actor/hero/parts/status-tracks.hbs"}}

{{> "systems/veilrunner/templates/actor/hero/parts/energy-pools.hbs"}}

      <div class="hero-resource-divider" aria-hidden="true"></div>

{{> "systems/veilrunner/templates/actor/hero/parts/resources.hbs"}}
{{> "systems/veilrunner/templates/actor/hero/parts/party.hbs"}}
    </div>

    <div class="main-field">
      {{> "systems/veilrunner/templates/actor/hero/parts/top-nav.hbs"}}

      {{#if subNavList}}
{{> "systems/veilrunner/templates/actor/hero/parts/sub-navigation.hbs"}}
{{> "systems/veilrunner/templates/actor/hero/parts/inventory-toolbar.hbs"}}
      {{/if}}

      <div class="section-body {{mainTabAnimationClass}}">
        {{#if (eq section "arsenal")}}
{{> "systems/veilrunner/templates/actor/hero/parts/arsenal.hbs"}}
        {{else if (eq section "character")}}
{{> "systems/veilrunner/templates/actor/hero/parts/character.hbs"}}
        {{else if (eq section "actions")}}
{{> "systems/veilrunner/templates/actor/hero/parts/actions.hbs"}}
        {{else if (eq section "inventory")}}
{{> "systems/veilrunner/templates/actor/hero/parts/inventory.hbs"}}
        {{else if (eq section "assets")}}
{{> "systems/veilrunner/templates/actor/hero/parts/assets.hbs"}}
        {{else if (eq section "settings")}}
{{> "systems/veilrunner/templates/actor/hero/parts/settings.hbs"}}
        {{/if}}
      </div>
{{> "systems/veilrunner/templates/actor/hero/parts/inventory-footer.hbs"}}
    </div>
  </div>
</section>
