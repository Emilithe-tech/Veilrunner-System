          {{#if (eq subTabs.character "stats")}}
            <div class="stats-sections">
              <section class="stats-section stats-attributes-section">
                <h1 data-stats-hint="Your physical, mental, and social attributes.">Attributes</h1>
                <div class="attribute-groups">
                  {{#each attributeGroups as |group|}}
                    <section class="attribute-group attribute-group-{{group.key}}">
                      <h2 class="attribute-group-heading" data-stats-hint="{{group.heading}} attributes.">
                        <span class="attribute-group-icon" aria-hidden="true"><i class="{{group.icon}}"></i></span>
                        <span>{{group.heading}}</span>
                      </h2>
                      <div class="attribute-grid">
                        {{#each group.attributes as |attr|}}
                          <label class="attribute-row" data-stats-hint="{{attr.label}}: {{attr.hint}}">
                            <span class="attribute-label">{{attr.label}}</span>
                            {{#if ../../editMode}}
                              <input type="number" name="{{attr.path}}" value="{{attr.value}}" />
                            {{else}}
                              <strong>{{attr.value}}</strong>
                            {{/if}}
                          </label>
                        {{/each}}
                      </div>
                    </section>
                  {{/each}}
                </div>
              </section>
              <section class="stats-section">
                <h1 data-stats-hint="Movement, available actions and reactions, resource capacities, and initiative.">Combat</h1>
                <div class="stats-summary-grid">
                  {{#each combatStats as |stat|}}
                    <div class="stats-summary-row{{#if stat.initiative}} stats-initiative-row{{/if}}" data-stats-hint="{{stat.label}}: {{stat.rule}}">
                      <span>{{stat.label}}</span>
                      {{#if stat.initiative}}
                        <div class="stats-initiative-value">
                          <strong>{{stat.value}}</strong>
                          <span>+</span>
                          <button type="button" data-action="rollInitiative" aria-label="Roll initiative: {{stat.initiativeFormula}}"><i class="fa-solid fa-dice-d10"></i></button>
                        </div>
                      {{else}}
                        <strong title="{{stat.rule}}">{{stat.value}}</strong>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
              </section>
              <section class="stats-section">
                <h1 data-stats-hint="Your Fortitude, Willpower, and Reflex saving throw values.">Saves</h1>
                <div class="stats-summary-grid">
                  {{#each saves as |save|}}
                    <label class="stats-summary-row" data-stats-hint="{{save.label}}: Your current saving throw value is {{save.value}}."><span>{{save.label}}</span>{{#if ../editMode}}<input type="number" name="{{save.path}}" value="{{save.value}}" min="0" />{{else}}<strong>{{save.value}}</strong>{{/if}}</label>
                  {{/each}}
                </div>
              </section>
            </div>
          {{else if (eq subTabs.character "skills")}}
            <h1>{{localize 'VEILRUNNER.Skills'}}</h1>
            {{#each skillCategories as |cat|}}
              <div class="skill-category">
                <div class="skill-category-heading"><i class="{{cat.icon}}"></i> {{cat.label}}</div>
                {{#each cat.skills as |skill|}}
                  <div class="skill-row">
                    <span class="skill-name">{{skill.label}}</span>
                    <span class="skill-modifier">+{{skill.modifier}}</span>
                    <span class="skill-rank rank-{{lowercase skill.rank}}">{{skill.rank}}</span>
                    <span class="skill-dots">
                      {{#each skill.dotsArray as |filled|}}
                        <span class="dot {{#if filled}}filled{{/if}}"></span>
                      {{/each}}
                    </span>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <div class="empty-row">{{localize 'VEILRUNNER.NoSkills'}}</div>
            {{/each}}
          {{else if (eq subTabs.character "progression")}}
            {{> "systems/veilrunner/templates/actor/hero/parts/progression.hbs"}}
          {{else if (eq subTabs.character "relations")}}
            <div data-hero-relations>{{{relationsWorkspace}}}</div>
