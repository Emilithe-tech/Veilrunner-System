{"_id":"906fbfcbddab4de6","name":"Last Word","type":"action","img":"icons/svg/lightning.svg","system":{"definitionId":"veilrunner.unique-reactions.berserker.warrior.last-word","intents":["action-provider","reaction-provider"],"providedActionIds":[],"activationKind":"action","actionType":"reaction","category":"reactions","favorite":false,"actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"cost":"","rollFormula":"","selector":"reaction","requiredItemTypes":[],"requiredItemTraits":[],"requiredDefinitionIds":[],"requiredItemIntents":[],"requiresTarget":false,"requiredEffects":[],"requiredTargetEffects":[],"composer":[],"summary":"","description":"<p>Make a decisive strike when a foe tries to leave your reach. The strike deals one higher damage threshold, triples critical damage, and increases your damage by 1d8 for the next round. Once per Field Recovery.</p>","traits":["reaction"]},"effects":[],"folder":null,"sort":100000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Berserker","discipline":"Warrior","sourceAbilityName":"Last Word","sourceType":"Reaction","rulesText":"Make a decisive strike when a foe tries to leave your reach. The strike deals one higher damage threshold, triples critical damage, and increases your damage by 1d8 for the next round. Once per Field Recovery."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"a0f69f3ca2dbc9d6","name":"Second Wind","type":"action","img":"icons/svg/lightning.svg","system":{"definitionId":"veilrunner.unique-reactions.martial-artist.fist-fighter.second-wind","intents":["action-provider","reaction-provider"],"providedActionIds":[],"activationKind":"action","actionType":"reaction","category":"reactions","favorite":false,"actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"cost":"","rollFormula":"","selector":"reaction","requiredItemTypes":[],"requiredItemTraits":[],"requiredDefinitionIds":[],"requiredItemIntents":[],"requiresTarget":false,"requiredEffects":[],"requiredTargetEffects":[],"composer":[],"summary":"","description":"<p>When lethal damage would knock you out, prevent the lethal result and set your HP to 1 after the attack resolves. Once per long rest.</p>","traits":["reaction"]},"effects":[],"folder":null,"sort":300000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Martial Artist","discipline":"Fist Fighter","sourceAbilityName":"Second Wind","sourceType":"Reaction","rulesText":"When lethal damage would knock you out, prevent the lethal result and set your HP to 1 after the attack resolves. Once per long rest."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"b54d208c93e47c09","name":"Last Stand","type":"action","img":"icons/svg/lightning.svg","system":{"definitionId":"veilrunner.unique-reactions.berserker.reaver.last-stand","intents":["action-provider","reaction-provider"],"providedActionIds":[],"activationKind":"action","actionType":"reaction","category":"reactions","favorite":false,"actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"cost":"","rollFormula":"","selector":"reaction","requiredItemTypes":[],"requiredItemTraits":[],"requiredDefinitionIds":[],"requiredItemIntents":[],"requiresTarget":false,"requiredEffects":[],"requiredTargetEffects":[],"composer":[],"summary":"","description":"<p>Gain temporary HP equal to 20% of maximum HP until the end of your next turn when facing a killing blow. If you defeat a target before then, the temporary HP becomes normal HP. Once per long rest.</p>","traits":["reaction"]},"effects":[],"folder":null,"sort":200000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Berserker","discipline":"Reaver","sourceAbilityName":"Last Stand","sourceType":"Reaction","rulesText":"Gain temporary HP equal to 20% of maximum HP until the end of your next turn when facing a killing blow. If you defeat a target before then, the temporary HP becomes normal HP. Once per long rest."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"da4be026001f7e40","name":"Emergency Stim","type":"action","img":"icons/svg/lightning.svg","system":{"definitionId":"veilrunner.unique-reactions.field-technician.combat-medic.emergency-stim","intents":["action-provider","reaction-provider"],"providedActionIds":[],"activationKind":"action","actionType":"reaction","category":"reactions","favorite":false,"actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"cost":"","rollFormula":"","selector":"reaction","requiredItemTypes":[],"requiredItemTraits":[],"requiredDefinitionIds":[],"requiredItemIntents":[],"requiresTarget":false,"requiredEffects":[],"requiredTargetEffects":[],"composer":[],"summary":"","description":"<p>Administer urgent aid when an ally is attacked or wounded, giving them a chance to keep fighting.</p>","traits":["reaction"]},"effects":[],"folder":null,"sort":400000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Field Technician","discipline":"Combat Medic","sourceAbilityName":"Emergency Stim","sourceType":"Reaction","rulesText":"Administer urgent aid when an ally is attacked or wounded, giving them a chance to keep fighting."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
