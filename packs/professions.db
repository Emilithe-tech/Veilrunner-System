{"_id":"0kNT4Te941nhVJ5A","name":"Duelist - Samurai","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Armament","profession":"Duelist","discipline":"Samurai","quote":"","primaryWeapon":"Long Blades","primaryAttributes":["Dexterity","Strength"],"bonusAttributes":["Strength","Reaction"],"bonusSkill":"Long Blades","persona":["Empathetic","Collectivist"],"pageImage":"assets/img/professions/duelist.png","sourcePage":"7","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/duelist.png\" alt=\"Duelist - Samurai PDF page 7\" /></figure>"},"effects":[],"folder":null,"sort":1000000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Duelists are blade masters, often hired for clean work by megacorps and fixers.","disciplineSummary":"A long-blade specialist trained to disable shields and end fights with precise strikes.","abilities":[{"name":"Disabling Holshi Shatter","type":"Action >>","text":"With a short blade, strike a Holtzman shield. Outcomes range from no effect to bypassing and disabling the shield for 1d4 or 2d4 turns. Three uses per long rest."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
{"_id":"2fh38TXlV5UgQqRa","name":"Amplifier - Augmenter","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Magic","profession":"Amplifier","discipline":"Augmenter","quote":"","primaryWeapon":"Varies","primaryAttributes":["Intelligence","Wisdom"],"bonusAttributes":["Dexterity","Strength"],"bonusSkill":"Resist Damage","persona":["Empathetic","Individual"],"pageImage":"assets/img/professions/amplifier.png","sourcePage":"12","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/amplifier.png\" alt=\"Amplifier - Augmenter PDF page 12\" /></figure>"},"effects":[],"folder":null,"sort":2000000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Amplifiers enhance themselves and allies while inhibiting enemies with specialized intrinsic magic.","disciplineSummary":"A self-enhancing caster who adapts by augmenting core abilities with magic.","abilities":[{"name":"Enhanced Augmentation","type":"Trait","text":"When casting an augmentation spell on yourself, choose Potency, Duration, or Duplication. Only one enhanced augmentation can be active at a time."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
{"_id":"6ZoGSufF16OCoI9w","name":"Vanguard - Paladin","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Physique","profession":"Vanguard","discipline":"Paladin","quote":"","primaryWeapon":"Sword & Light Shield","primaryAttributes":["Strength","Reaction"],"bonusAttributes":["Reaction","Intelligence"],"bonusSkill":"Throw Shield","persona":["Empathetic","Collectivist"],"pageImage":"assets/img/professions/vanguard.png","sourcePage":"6","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/vanguard.png\" alt=\"Vanguard - Paladin PDF page 6\" /></figure>"},"effects":[],"folder":null,"sort":800000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Vanguards protect allies by drawing attacks and fire. They rely on physical shields, heavy armor, and energy shields.","disciplineSummary":"A defender using vitalism and divine magic to augment defense and restore allies.","abilities":[{"name":"Reprisal","type":"Ability","text":"With a shield equipped, retaliate after blocking a melee attack. The strike uses the current round's multi-attack penalty and costs no action or reaction."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
{"_id":"7IqLdsuToHOwiU2J","name":"Field Technician - Beast Tamer","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Armament","profession":"Field Technician","discipline":"Beast Tamer","quote":"","primaryWeapon":"Light Firearms","primaryAttributes":["Dexterity","Focus"],"bonusAttributes":["Charisma","Perception"],"bonusSkill":"Train Creature","persona":["Empathetic","Lawful"],"pageImage":"assets/img/professions/field-technician-1.png","sourcePage":"8","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/field-technician-1.png\" alt=\"Field Technician - Beast Tamer PDF page 8\" /></figure>"},"effects":[],"folder":null,"sort":1200000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Field Technicians solve problems with chemistry, companions, explosives, and emergency medical work.","disciplineSummary":"A creature handler who can pacify hostile beasts and benefit from a companion's senses.","abilities":[{"name":"Overriding Dominance","type":"Action >>","text":"Roll Train Creature + Charisma against a hostile creature. Outcomes range from no effect to pacified, allied, or tamed for the encounter."},{"name":"Enhanced Senses","type":"Trait","text":"With a creature companion summoned, you may use the companion's Perception modifier for tracking, detection, or perception rolls."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
{"_id":"8rH2NTN1EyJSATrm","name":"Marksman - Shocktrooper","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Armament","profession":"Marksman","discipline":"Shocktrooper","quote":"","primaryWeapon":"Heavy Firearms","primaryAttributes":["Strength","Dexterity"],"bonusAttributes":["Dexterity","Strength"],"bonusSkill":"Heavy Firearms","persona":["Collectivist"],"pageImage":"assets/img/professions/marksman-2.png","sourcePage":"11","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/marksman-2.png\" alt=\"Marksman - Shocktrooper PDF page 11\" /></figure>"},"effects":[],"folder":null,"sort":1800000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Marksmen leave their mark with projectile weapons and often specialize in a favored style of firearm or bow.","disciplineSummary":"A heavy-weapons specialist suited to explosive encounters, suppressive fire, and battlefield hardware.","abilities":[{"name":"Braced Firing","type":"Trait","text":"If you have not moved this round, add +3 to attack rolls."},{"name":"This is My Weapon Now!","type":"Action >>","text":"Take control of or repurpose a stationary weapon or drone emplacement against your enemies."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
{"_id":"90SUr9MQYSt1vYDt","name":"Berserker - Warrior","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Physique","profession":"Berserker","discipline":"Warrior","quote":"","primaryWeapon":"Great Axe","primaryAttributes":["Strength","Reaction"],"bonusAttributes":["Agility","Strength"],"bonusSkill":"Rage","persona":["Ruthless","Criminal"],"pageImage":"assets/img/professions/berserker.png","sourcePage":"3","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/berserker.png\" alt=\"Berserker - Warrior PDF page 3\" /></figure>"},"effects":[],"folder":null,"sort":100000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Berserkers harness innate bodily energy and push beyond normal mortal limits. They excel in close quarters and deliver powerful strikes.","disciplineSummary":"A rage-based martial combatant that escalates close-quarters fights with deadly force and aggression.","abilities":[{"name":"Last Word","type":"Reaction","text":"Make a decisive strike when a foe tries to leave your reach. The strike deals one higher damage threshold, triples critical damage, and increases your damage by 1d8 for the next round. Once per Field Recovery."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
{"_id":"BJv9hicyYbprVWTM","name":"Vanguard - Shield Guardian","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Physique","profession":"Vanguard","discipline":"Shield Guardian","quote":"","primaryWeapon":"Heavy Shield","primaryAttributes":["Strength","Reaction"],"bonusAttributes":["Dexterity","Reaction"],"bonusSkill":"Shield Bash","persona":["Ruthless","Collectivist"],"pageImage":"assets/img/professions/vanguard.png","sourcePage":"6","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/vanguard.png\" alt=\"Vanguard - Shield Guardian PDF page 6\" /></figure>"},"effects":[],"folder":null,"sort":700000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Vanguards protect allies by drawing attacks and fire. They rely on physical shields, heavy armor, and energy shields.","disciplineSummary":"An immovable defender who holds position against assaults and protects nearby allies.","abilities":[{"name":"Extended Shifting Block","type":"Trait","text":"With a shield equipped, shift into place when an ally is attacked. Your shifting block range increases by reach + 4m and you may shift the ally up to your reach."},{"name":"Steel Resolve","type":"Ability","text":"With a shield equipped, resist half damage rounded down for the next round. Twice per Field Recovery."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
{"_id":"CiT65uudRYP4MdUx","name":"Field Technician - Demolitionist","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Armament","profession":"Field Technician","discipline":"Demolitionist","quote":"","primaryWeapon":"Light Firearms","primaryAttributes":["Intelligence","Focus"],"bonusAttributes":["Dexterity","Focus"],"bonusSkill":"Explosives","persona":["Ruthless","Individual"],"pageImage":"assets/img/professions/field-technician-2.png","sourcePage":"9","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/field-technician-2.png\" alt=\"Field Technician - Demolitionist PDF page 9\" /></figure>"},"effects":[],"folder":null,"sort":1300000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Field Technicians solve problems with chemistry, companions, explosives, and emergency medical work.","disciplineSummary":"An explosive specialist who disarms bombs and turns structural weaknesses into bigger blasts.","abilities":[{"name":"Knack for Disarming","type":"Trait","text":"Add Explosives skill level to disarming rolls against explosives."},{"name":"Sense Structural Weakness","type":"Trait","text":"When placing explosives on artillery, drones, or vehicles with the mechanical trait, add 1d4 explosive damage per Explosives level."},{"name":"Explosives go Boom!","type":"Trait","text":"Gain +2d6 damage with explosives, and add Explosives level to attack rolls using explosive weapons or ammunition."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
