{"_id":"0b27e862ef300644","name":"Assassinate","type":"action","img":"icons/svg/sword.svg","system":{"definitionId":"veilrunner.unique-actions.duelist.assassin.assassinate","intents":["action-provider"],"providedActionIds":[],"activationKind":"action","actionType":"standard","category":"actions","favorite":false,"actions":2,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"cost":"","rollFormula":"","selector":"action","requiredItemTypes":[],"requiredItemTraits":[],"requiredDefinitionIds":[],"requiredItemIntents":[],"requiresTarget":false,"requiredEffects":[],"requiredTargetEffects":[],"composer":[],"summary":"","description":"<p>With a short blade, strike a badly injured target with no active armor, shields, or barrier. Outcomes scale from contested state to triple critical damage. Three uses per long rest.</p>","traits":["action"]},"effects":[],"folder":null,"sort":100000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Duelist","discipline":"Assassin","sourceAbilityName":"Assassinate","sourceType":"Action >>","rulesText":"With a short blade, strike a badly injured target with no active armor, shields, or barrier. Outcomes scale from contested state to triple critical damage. Three uses per long rest."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
