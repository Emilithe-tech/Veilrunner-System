{"_id":"a6c4496e1205d11e","name":"Elemental Frenzy","type":"ability","img":"icons/svg/upgrade.svg","system":{"definitionId":"veilrunner.unique-abilities.elemental-adept.versatile-adept.elemental-frenzy","intents":["action-provider"],"providedActionIds":[],"featured":false,"category":"actions","actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"recharge":"","summary":"","description":"<p>Increase potency of elemental spells you cast by 1d4 until the end of your next turn. At level 10 and every 10 levels thereafter, increase damage by 1d4 and duration by one round. Once per long rest.</p>","traits":["ability"]},"effects":[],"folder":null,"sort":700000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Elemental Adept","discipline":"Versatile Adept","sourceAbilityName":"Elemental Frenzy","sourceType":"Ability","rulesText":"Increase potency of elemental spells you cast by 1d4 until the end of your next turn. At level 10 and every 10 levels thereafter, increase damage by 1d4 and duration by one round. Once per long rest."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"a90c9f029e34829d","name":"Reprisal","type":"ability","img":"icons/svg/upgrade.svg","system":{"definitionId":"veilrunner.unique-abilities.vanguard.paladin.reprisal","intents":["action-provider"],"providedActionIds":[],"featured":false,"category":"actions","actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"recharge":"","summary":"","description":"<p>With a shield equipped, retaliate after blocking a melee attack. The strike uses the current round's multi-attack penalty and costs no action or reaction.</p>","traits":["ability"]},"effects":[],"folder":null,"sort":300000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Vanguard","discipline":"Paladin","sourceAbilityName":"Reprisal","sourceType":"Ability","rulesText":"With a shield equipped, retaliate after blocking a melee attack. The strike uses the current round's multi-attack penalty and costs no action or reaction."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
