{{#if descriptionValue}}
<section class="vr-item-panel"><div class="vr-item-heading-row"><h2 class="section-heading">Overview</h2>{{#if editable}}<button type="button" class="vr-item-icon-button" data-sheet-action="editDescription" aria-label="Edit description"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{/if}}</div>
  {{#if descriptionEditing}}<prose-mirror class="vr-item-description-editor" name="{{descriptionPath}}" value="{{descriptionValue}}">{{{descriptionHTML}}}</prose-mirror>{{else}}<div class="vr-item-prose">{{{descriptionHTML}}}</div>{{/if}}
</section>
{{else}}{{#if editable}}<section class="vr-item-panel"><h2 class="section-heading">Overview</h2><prose-mirror class="vr-item-description-editor" name="{{descriptionPath}}" value="{{descriptionValue}}">{{{descriptionHTML}}}</prose-mirror></section>{{/if}}{{/if}}
{{#if overview.features.length}}<section class="vr-item-panel"><h2 class="section-heading">Features</h2><div class="vr-item-card-grid">{{#each overview.features}}<article class="vr-item-feature"><i class="fa-solid {{icon}} vr-item-feature-icon" aria-hidden="true"></i><div><h3>{{label}}</h3>{{#if description}}<p>{{description}}</p>{{/if}}{{#if definitionId}}<button type="button" data-sheet-action="openDefinition" data-definition-id="{{definitionId}}">View feature</button>{{/if}}</div></article>{{/each}}</div></section>{{/if}}
{{#if overview.damage.length}}<section class="vr-item-panel"><h2 class="section-heading">Damage profile</h2><div class="vr-item-card-grid">{{#each overview.damage}}<div class="vr-item-damage"><i class="{{icon}}" aria-hidden="true"></i><span>{{label}}</span><strong>{{value}}</strong></div>{{/each}}</div></section>{{/if}}
{{#if system.mechanics}}<section class="vr-item-panel"><h2 class="section-heading">Usage</h2><div class="vr-item-prose">{{{mechanicsHTML}}}</div></section>{{/if}}
{{#if overview.progression}}<section class="vr-item-panel"><h2 class="section-heading">Progression</h2><p>{{#if overview.progression.current}}Current level {{overview.progression.current}} · {{/if}}Maximum level {{overview.progression.max}}</p>{{#if overview.progression.scaling.length}}{{> "systems/veilrunner/templates/item/parts/rows.hbs" rows=overview.progression.scaling}}{{/if}}</section>{{/if}}
{{#if overview.condition}}<section class="vr-item-panel"><h2 class="section-heading">Condition</h2><div class="vr-item-condition"><meter min="0" max="{{overview.condition.max}}" value="{{overview.condition.value}}" aria-label="Condition"></meter><span>{{overview.condition.value}} / {{overview.condition.max}}</span></div></section>{{/if}}
