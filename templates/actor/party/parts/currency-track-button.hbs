<button type="button" class="vr-party-v2-track-button {{#if tracked}}is-tracked{{/if}}" data-action="toggleCurrencyTracking" data-index="{{index}}" title="{{#if tracked}}{{localize 'VEILRUNNER.UntrackCurrency'}}{{else}}{{localize 'VEILRUNNER.TrackCurrency'}}{{/if}}"><i class="{{#if tracked}}fa-solid fa-eye{{else}}fa-regular fa-eye-slash{{/if}}"></i></button>
