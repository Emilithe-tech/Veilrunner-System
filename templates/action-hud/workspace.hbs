<main class="vr-hud-workspace vr-hud-panel {{#if workspaceLibrary}}is-library{{else if workspaceNormal}}is-normal{{/if}}" aria-label="Combat actions">
  {{#if workspaceComposer}}
    <form class="vr-hud-composer">
      <header><button type="button" data-action="setWorkspace" data-workspace="normal"><i class="fa-solid fa-chevron-left"></i> Back</button><div>{{#if composer.action.weaponComposer}}<strong>{{composer.action.weaponComposer.weaponName}}</strong><span>{{composer.action.weaponComposer.weaponType}} Weapon</span>{{else}}<strong>{{composer.action.name}}</strong><span>{{composer.action.domain}} · {{composer.action.actionMode}}</span>{{/if}}</div>{{#if composer.action.weaponComposer}}<em><i class="fa-solid fa-bullets"></i> {{composer.action.weaponComposer.ammoCurrent}} / {{composer.action.weaponComposer.ammoCapacity}}</em>{{else if composer.action.mapPenalty}}<em>MAP {{composer.action.mapPenalty}}</em>{{/if}}</header>
      {{#if composer.action.weaponComposer}}
      <div class="vr-hud-weapon-composer">
        <section class="vr-hud-fire-modes"><h3>Fire Mode</h3><div>{{#each composer.action.weaponComposer.modes as |mode|}}<label class="{{#if mode.selected}}selected{{/if}}"><input data-composer-input type="radio" name="fireMode" value="{{mode.id}}" {{#if mode.selected}}checked{{/if}} /><strong>{{mode.label}}</strong><span>{{mode.actions}} AP · {{mode.ammoCost}} Ammo</span></label>{{/each}}</div></section>
        <section class="vr-hud-weapon-stats"><h3>Weapon Stats</h3><div><span><small>Attack</small><strong>{{composer.action.weaponComposer.attackFormula}}{{#if composer.action.attackModifier}} + {{composer.action.attackModifier}}{{/if}}</strong></span><span><small>Damage</small><strong>{{#if composer.action.damageFormula}}{{composer.action.damageFormula}}{{else}}{{composer.action.weaponComposer.damageFormula}}{{/if}}{{#if composer.action.damageModifier}} + {{composer.action.damageModifier}}{{/if}}</strong></span><span><small>Type</small><strong>{{composer.action.weaponComposer.damageType}}</strong></span><span><small>AP Cost</small><strong>{{composer.action.actionCount}}</strong></span><span><small>Ammo</small><strong>{{composer.action.ammoCost}}</strong></span><span><small>Range</small><strong>{{composer.action.range}}</strong></span><span><small>MAP</small><strong>{{#if composer.action.mapPenalty}}{{composer.action.mapPenalty}}{{else}}0{{/if}}</strong></span></div></section>
        {{#if composer.action.weaponComposer.options.length}}<section class="vr-hud-weapon-options"><h3>Options</h3><div>{{#each composer.action.weaponComposer.options as |option|}}<label title="{{option.description}}"><input data-composer-input type="checkbox" name="weaponOption:{{option.id}}" value="1" {{#if option.selected}}checked{{/if}} /><span><strong>{{option.label}}</strong>{{#if option.description}}<small>{{option.description}}</small>{{/if}}</span></label>{{/each}}</div></section>{{/if}}
        <section class="vr-hud-weapon-outcome"><h3>Projected Outcome</h3><div><span><small>Attack Formula</small><strong>{{composer.action.weaponComposer.attackFormula}}</strong></span><span><small>Damage</small><strong>{{#if composer.action.damageFormula}}{{composer.action.damageFormula}}{{else}}{{composer.action.weaponComposer.damageFormula}}{{/if}}</strong></span><span><small>Damage Maximum</small><strong>{{composer.action.weaponComposer.damageMaximum}}</strong></span><span><small>Ammunition</small><strong>{{composer.action.weaponComposer.ammoCurrent}} / {{composer.action.weaponComposer.ammoCapacity}}</strong></span></div>{{#if composer.action.errors.length}}<p>{{lookup composer.action.errors 0}}</p>{{/if}}</section>
      </div>
      <div class="vr-hud-composer-actions"><button class="vr-hud-prepare" type="button" data-action="prepareComposer" {{#unless composer.action.valid}}disabled title="{{lookup composer.action.errors 0}}"{{/unless}}><i class="fa-solid fa-clipboard-list"></i> Prepare for Turn</button><button class="vr-hud-primary" type="button" data-action="executeComposer" {{#unless composer.action.availability.available}}disabled title="{{composer.action.availability.reason}}"{{/unless}}><i class="fa-solid fa-crosshairs"></i> Fire Now</button></div>
      {{else}}
      <div class="vr-hud-composer-grid">
        <section>
          <h3>Configuration</h3>
          {{#each composer.action.composer as |field|}}
            <label><span>{{field.label}}</span>
              {{#if (eq field.type "rank")}}<input data-composer-input type="number" name="{{field.key}}" min="{{field.min}}" max="{{field.max}}" value="{{lookup ../composer.selections field.key}}" />
              {{else if (eq field.type "toggle")}}<input data-composer-input type="checkbox" name="{{field.key}}" value="1" {{checked (lookup ../composer.selections field.key)}} />
              {{else}}<select data-composer-input name="{{field.key}}">{{#each field.choices as |choice|}}<option value="{{choice}}" {{#if (eq choice (lookup ../../composer.selections ../key))}}selected{{/if}}>{{choice}}</option>{{/each}}</select>{{/if}}
            </label>
          {{/each}}
          {{#if composer.action.spellComposer}}
            <label class="vr-hud-spell-level"><span>Spell Level</span><div><input data-composer-input data-spell-level type="range" min="{{composer.action.spellComposer.level.min}}" max="{{composer.action.spellComposer.level.max}}" step="1" value="{{composer.action.spellComposer.level.value}}" aria-label="Spell level slider" /><input data-composer-input data-spell-level type="number" name="spellLevel" min="{{composer.action.spellComposer.level.min}}" max="{{composer.action.spellComposer.level.max}}" step="1" value="{{composer.action.spellComposer.level.value}}" aria-label="Spell level" /></div></label>
          {{else if composer.action.hasLevelSelection}}<label><span>Rank</span><input data-composer-input type="number" name="rank" min="1" max="{{composer.action.currentLevel}}" value="{{lookup composer.selections 'rank'}}" /></label>{{/if}}
          {{#each composer.action.enhancements as |enhancement|}}<label><span>{{enhancement.label}}</span><input data-composer-input type="number" name="enhancement:{{enhancement.id}}" min="0" max="{{enhancement.maxStacks}}" value="{{lookup ../composer.selections (concat 'enhancement:' enhancement.id)}}" /></label>{{/each}}
          {{#if composer.action.spellComposer}}
            <h3>Spell Modifiers</h3>
            <div class="vr-hud-spell-modifiers">
              {{#each composer.action.spellComposer.modifiers as |modifier|}}
                <label data-spell-modifier class="{{#if modifier.enabled}}selected{{/if}} {{#unless modifier.stackable}}is-binary{{/unless}}" title="{{modifier.description}}">
                  <span class="vr-hud-modifier-toggle"><input type="hidden" name="spellModifierEnabled:{{modifier.id}}" value="0" /><input data-composer-input data-spell-modifier-enabled type="checkbox" name="spellModifierEnabled:{{modifier.id}}" value="1" {{checked modifier.enabled}} aria-label="Toggle {{modifier.label}}" /></span>
                  {{#if modifier.stackable}}<span class="vr-hud-modifier-stepper"><button type="button" data-action="adjustSpellModifier" data-delta="1" aria-label="Increase {{modifier.label}}"><i class="fa-solid fa-caret-up" aria-hidden="true"></i></button><input data-composer-input data-spell-modifier-count type="number" name="spellModifier:{{modifier.id}}" min="0" max="{{modifier.maxStacks}}" value="{{modifier.count}}" aria-label="{{modifier.label}} stacks" /><button type="button" data-action="adjustSpellModifier" data-delta="-1" aria-label="Decrease {{modifier.label}}"><i class="fa-solid fa-caret-down" aria-hidden="true"></i></button></span>{{/if}}
                  <span class="vr-hud-modifier-copy"><strong>{{modifier.label}}</strong><small>{{modifier.costLabel}}</small><em>{{modifier.description}}</em></span>
                </label>
              {{/each}}
            </div>
          {{/if}}
        </section>
        <section class="vr-hud-projected-cost"><header class="vr-hud-projected-cost-header"><h3>Projected Cost</h3>{{#if composer.action.damageOutcome.available}}<div class="vr-hud-estimated-damage"><span>Estimated {{#if composer.action.damageType}}{{composer.action.damageType}} {{/if}}Damage</span><strong class="vr-hud-formula-tokens"><mark class="dice">{{composer.action.damageOutcome.formula}}{{#if composer.action.damageIcon}} <i class="{{composer.action.damageIcon}} damage-type-{{composer.action.damageType}}" aria-hidden="true"></i>{{/if}}</mark></strong></div>{{/if}}</header>{{#if composer.action.damageOutcome.available}}<div class="vr-hud-damage-metrics"><em>Range {{composer.action.damageOutcome.minimum}}–{{composer.action.damageOutcome.maximum}}</em><em>Average {{composer.action.damageOutcome.average}}</em></div>{{/if}}{{#each composer.preview as |entry|}}<div class="vr-hud-preview {{#unless entry.affordable}}over-budget{{/unless}}"><span>{{entry.key}}</span><strong>{{entry.before}} → {{entry.after}}</strong><em>−{{entry.cost}}{{#unless entry.affordable}} · Short {{entry.shortfall}}{{/unless}}</em></div>{{else}}<p>No projected resource cost.</p>{{/each}}<details class="vr-hud-calculation" {{#if hud.calculationOpen}}open{{/if}}><summary>Calculation</summary><div>{{#each composer.action.breakdown as |entry|}}<span class="{{#if entry.final}}final{{/if}}"><b>{{entry.label}}</b><em>{{entry.value}}</em></span>{{/each}}</div><p>All values are revalidated when the action executes.</p></details></section>
      </div>
      <div class="vr-hud-composer-actions"><button class="vr-hud-prepare" type="button" data-action="prepareComposer" {{#unless composer.action.valid}}disabled title="{{lookup composer.action.errors 0}}"{{/unless}}><i class="fa-solid fa-clipboard-list"></i> Prepare for Turn</button><button class="vr-hud-primary" type="button" data-action="executeComposer" {{#unless composer.action.valid}}disabled{{/unless}} {{#unless composer.action.availability.available}}disabled{{/unless}} title="{{#unless composer.action.valid}}{{lookup composer.action.errors 0}}{{else}}{{composer.action.availability.reason}}{{/unless}}">Execute Now</button></div>
      {{/if}}
    </form>
  {{else if workspaceWeapons}}
    <header class="vr-hud-workspace-header"><button type="button" data-action="setWorkspace" data-workspace="normal"><i class="fa-solid fa-chevron-left"></i> Back</button><strong>Switch Weapon</strong><input data-weapon-search type="search" value="{{weaponQuery}}" placeholder="Name, category, trait…" /></header>
    <nav class="vr-hud-weapon-filters"><button type="button" data-action="setWeaponFilter" data-weapon-filter="all" class="{{#if (eq weaponFilter 'all')}}active{{/if}}">All</button><button type="button" data-action="setWeaponFilter" data-weapon-filter="recent" class="{{#if (eq weaponFilter 'recent')}}active{{/if}}">Recent</button><button type="button" data-action="setWeaponFilter" data-weapon-filter="favorites" class="{{#if (eq weaponFilter 'favorites')}}active{{/if}}">Favorites</button>{{#each weaponFamilies as |family|}}<button type="button" data-action="setWeaponFilter" data-weapon-filter="{{family.id}}" class="{{#if (eq family.id ../weaponFilter)}}active{{/if}}">{{family.label}}</button>{{/each}}</nav>
    <div class="vr-hud-weapon-grid">{{#each weapons as |weapon|}}<button type="button" data-action="equipWeapon" data-weapon-id="{{weapon.id}}" class="{{#if weapon.equipped}}equipped{{/if}}"><img src="{{weapon.img}}" alt="" /><span>{{weapon.name}}</span><em>{{weapon.category}}{{#if weapon.traits.length}} · {{weapon.traits}}{{/if}}</em>{{#if weapon.equipped}}<b>Equipped</b>{{else if weapon.favorite}}<b>Favorite</b>{{else if weapon.recent}}<b>Recent</b>{{/if}}</button>{{else}}<p class="vr-hud-empty">No matching weapons.</p>{{/each}}</div>
  {{else if workspaceSaves}}
    <header class="vr-hud-workspace-header"><button type="button" data-action="setWorkspace" data-workspace="normal"><i class="fa-solid fa-chevron-left"></i> Back</button><strong>{{#if requestedSave}}{{requestedSave.label}}{{else}}Saving Throws{{/if}}</strong>{{#if requestedSave.dc}}<em>DC {{requestedSave.dc}}</em>{{/if}}</header>
    <div class="vr-hud-save-grid">{{#each saves as |save|}}<button type="button" data-action="rollSave" data-save="{{save.key}}"><span>{{save.label}}</span><strong>+{{save.value}}</strong></button>{{/each}}</div>
  {{else if workspaceAsset}}
    <header class="vr-hud-workspace-header"><button type="button" data-action="setWorkspace" data-workspace="normal"><i class="fa-solid fa-chevron-left"></i> Back</button><strong>Asset Control</strong></header>
    {{#each assets as |asset|}}{{#if (eq asset.uuid ../hud.selectedAssetUuid)}}<section class="vr-hud-asset-context"><img src="{{asset.img}}" alt="" /><div><h3>{{asset.name}}</h3><span>{{asset.kind}}</span></div></section><div class="vr-hud-action-grid">{{#each asset.actions as |action|}}<button type="button" data-action="useAction" data-action-id="{{action.id}}"><img src="{{action.img}}" alt="" /><span>{{action.name}}</span></button>{{else}}<p>No authored asset actions.</p>{{/each}}</div>{{/if}}{{/each}}
  {{else if workspaceLibrary}}
    <div class="vr-hud-action-grid">{{#each actions as |action|}}<article class="vr-hud-action-card state-{{action.availability.state}}"><button type="button" data-action="useAction" data-action-id="{{action.id}}" {{#unless action.availability.available}}disabled title="{{action.availability.reason}}"{{/unless}}><img src="{{action.img}}" alt="" /><span>{{action.name}}</span><em>{{action.actionCount}} AP · {{action.category}}</em>{{#if action.mapPenalty}}<b>MAP {{action.mapPenalty}}</b>{{/if}}</button><button class="vr-hud-prepare-action" type="button" data-action="prepareAction" data-action-id="{{action.id}}" aria-label="Prepare {{action.name}} for your turn" title="Prepare for your turn"><i class="fa-solid fa-clipboard-list"></i></button><button class="vr-hud-pin" type="button" data-action="pinAction" data-action-id="{{action.id}}" aria-label="Pin {{action.name}}"><i class="fa-solid fa-thumbtack"></i></button></article>{{else}}<p class="vr-hud-empty">No matching actions.</p>{{/each}}</div>
    <footer class="vr-hud-workspace-footer"><button type="button" data-action="setWorkspace" data-workspace="normal"><i class="fa-solid fa-chevron-left"></i> Back</button><nav>{{#each domains as |domain|}}<button type="button" data-action="setDomain" data-domain="{{domain}}" class="{{#if (eq domain ../activeDomain)}}active{{/if}}">{{domain}}</button>{{/each}}</nav><input data-hud-search type="search" value="{{query}}" placeholder="Search actions, traits, source…" /></footer>
  {{else}}
    {{#if prepared.length}}<section class="vr-hud-prepared-turn"><header><span>Prepared Turn</span><em>Setup only — costs are spent when used</em></header><div>{{#each prepared as |action|}}<article class="{{#unless action.targetsMatch}}targets-changed{{/unless}}"><button type="button" data-action="executePrepared" data-prepared-id="{{action.preparedId}}" {{#unless action.availability.available}}disabled title="{{action.availability.reason}}"{{/unless}}><img src="{{action.img}}" alt="" /><span><strong>{{action.name}}</strong><small>{{action.actionCount}} AP{{#if action.plannedTargetCount}} · {{action.plannedTargetCount}} target{{#if (gt action.plannedTargetCount 1)}}s{{/if}}{{/if}}</small></span></button><button type="button" data-action="removePrepared" data-prepared-id="{{action.preparedId}}" aria-label="Remove prepared {{action.name}}"><i class="fa-solid fa-xmark"></i></button>{{#unless action.targetsMatch}}<em title="Planned: {{action.plannedTargetNames}}">Targets changed</em>{{/unless}}</article>{{/each}}</div></section>{{/if}}
    <div class="vr-hud-action-groups">
      <section class="vr-hud-equipped"><header><span>Equipped</span><button type="button" data-action="switchWeapon"><i class="fa-solid fa-repeat"></i> Switch</button></header><div>{{#each equipped as |item|}}<button type="button" data-action="openEquipped" data-item-id="{{item.id}}"><img src="{{item.img}}" alt="" /><span>{{item.name}}</span><em>{{item.type}}</em></button>{{else}}<button type="button" data-action="switchWeapon"><i class="fa-solid fa-plus"></i><span>Equip an item</span></button>{{/each}}</div></section>
      <section class="vr-hud-deck-section"><header><span>Context</span></header><div class="vr-hud-quick-row">{{#each context as |action|}}<button type="button" data-action="useAction" data-action-id="{{action.id}}" {{#unless action.availability.available}}disabled title="{{action.availability.reason}}"{{/unless}}><img src="{{action.img}}" alt="" /><span>{{action.name}}</span></button>{{else}}<span class="vr-hud-empty-slot">No contextual action.</span>{{/each}}</div></section>
      <section class="vr-hud-deck-section recent"><header><span>Recent</span></header><div class="vr-hud-quick-row">{{#each recent as |action|}}<button type="button" data-action="useAction" data-action-id="{{action.id}}" {{#unless action.availability.available}}disabled title="{{action.availability.reason}}"{{/unless}}><img src="{{action.img}}" alt="" /><span>{{action.name}}</span></button>{{else}}<span class="vr-hud-empty-slot">No recent actions.</span>{{/each}}</div></section>
      <section class="vr-hud-deck-section"><header><span>Pinned</span></header><div class="vr-hud-quick-row">{{#each pinned as |action|}}<button type="button" data-action="useAction" data-action-id="{{action.id}}" {{#unless action.availability.available}}disabled title="{{action.availability.reason}}"{{/unless}}><img src="{{action.img}}" alt="" /><span>{{action.name}}</span></button>{{else}}<span class="vr-hud-empty-slot">Pin actions from a library.</span>{{/each}}</div></section>
    </div>
    <nav class="vr-hud-domain-nav">{{#each domains as |domain|}}{{#if (eq domain 'assets')}}{{#each ../assets as |asset|}}<button type="button" data-action="selectAsset" data-asset-uuid="{{asset.uuid}}"><i class="fa-solid fa-paw"></i>{{asset.name}}</button>{{/each}}{{else}}<button type="button" data-action="setDomain" data-domain="{{domain}}">{{domain}}</button>{{/if}}{{/each}}<button type="button" data-action="setDomain" data-domain=""><i class="fa-solid fa-magnifying-glass"></i> Search</button></nav>
  {{/if}}
</main>
