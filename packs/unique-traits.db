{"_id":"e437aed35c6828ba","name":"Trained Medic","type":"ability","img":"icons/svg/aura.svg","system":{"definitionId":"veilrunner.unique-traits.field-technician.combat-medic.trained-medic","intents":["action-provider"],"providedActionIds":[],"featured":false,"category":"actions","actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"recharge":"","summary":"","description":"<p>Your time treating patients has given you real world experience. Administering medicine and treating wounds is something you can do quickly. You gain +3 to Medicine checks. You gain an additional hit point of healing for each level of Medicine that you take.</p>","traits":["trait"]},"effects":[],"folder":null,"sort":1200000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Field Technician","discipline":"Combat Medic","sourceAbilityName":"Trained Medic","sourceType":"Trait","rulesText":"Your time treating patients has given you real world experience. Administering medicine and treating wounds is something you can do quickly. You gain +3 to Medicine checks. You gain an additional hit point of healing for each level of Medicine that you take."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"e4c1a2d3f4cae584","name":"Extended Range","type":"ability","img":"icons/svg/aura.svg","system":{"definitionId":"veilrunner.unique-traits.marksman.sniper.extended-range","intents":["action-provider"],"providedActionIds":[],"featured":false,"category":"actions","actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"recharge":"","summary":"","description":"<p>With a long arm equipped, gain +20m range on strikes.</p>","traits":["trait"]},"effects":[],"folder":null,"sort":1400000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Marksman","discipline":"Sniper","sourceAbilityName":"Extended Range","sourceType":"Trait","rulesText":"With a long arm equipped, gain +20m range on strikes."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"e57c95cd58787939","name":"Green Thumb","type":"ability","img":"icons/svg/aura.svg","system":{"definitionId":"veilrunner.unique-traits.druid.cultivator.green-thumb","intents":["action-provider"],"providedActionIds":[],"featured":false,"category":"actions","actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"recharge":"","summary":"","description":"<p>When casting a spell with the floral trait, gain +1 to the attack roll for every five character levels.</p>","traits":["trait"]},"effects":[],"folder":null,"sort":2600000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Druid","discipline":"Cultivator","sourceAbilityName":"Green Thumb","sourceType":"Trait","rulesText":"When casting a spell with the floral trait, gain +1 to the attack roll for every five character levels."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"e67fb5daafd093ea","name":"Trained Gymnast","type":"ability","img":"icons/svg/aura.svg","system":{"definitionId":"veilrunner.unique-traits.gymnast.acrobat.trained-gymnast","intents":["action-provider"],"providedActionIds":[],"featured":false,"category":"actions","actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"recharge":"","summary":"","description":"<p>Gain +3 to Athletics dice roll results.</p>","traits":["trait"]},"effects":[],"folder":null,"sort":400000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Gymnast","discipline":"Acrobat","sourceAbilityName":"Trained Gymnast","sourceType":"Trait","rulesText":"Gain +3 to Athletics dice roll results."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"e8ef0f014db88767","name":"Geo Affinity","type":"ability","img":"icons/svg/aura.svg","system":{"definitionId":"veilrunner.unique-traits.magus.sorcerer.geo-affinity","intents":["action-provider"],"providedActionIds":[],"featured":false,"category":"actions","actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"recharge":"","summary":"","description":"<p>You have a natural affinity for Geo Magic and may have been able to connect and feel the innate connections of the soil early in life. When casting a spell that has the Geo trait, gain +5 to attack rolls when attempting to strike a target. Your attack bonus increases an additional +1 for every 10 character levels. Additionally, when you cast a spell with the Geo trait, gain an additional +1d8 damage at level 5 and every 5 levels thereafter.</p>","traits":["trait"]},"effects":[],"folder":null,"sort":3400000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Magus","discipline":"Sorcerer","sourceAbilityName":"Geo Affinity","sourceType":"Trait","rulesText":"You have a natural affinity for Geo Magic and may have been able to connect and feel the innate connections of the soil early in life. When casting a spell that has the Geo trait, gain +5 to attack rolls when attempting to strike a target. Your attack bonus increases an additional +1 for every 10 character levels. Additionally, when you cast a spell with the Geo trait, gain an additional +1d8 damage at level 5 and every 5 levels thereafter."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"ec8695396db87b2b","name":"Air Affinity","type":"ability","img":"icons/svg/aura.svg","system":{"definitionId":"veilrunner.unique-traits.elemental-adept.air-adept.air-affinity","intents":["action-provider"],"providedActionIds":[],"featured":false,"category":"actions","actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"recharge":"","summary":"","description":"<p>Aero spells gain +5 to attack rolls, +1 more every 10 levels, and +1d8 damage at level 5 and every 5 levels thereafter.</p>","traits":["trait"]},"effects":[],"folder":null,"sort":2900000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Elemental Adept","discipline":"Air Adept","sourceAbilityName":"Air Affinity","sourceType":"Trait","rulesText":"Aero spells gain +5 to attack rolls, +1 more every 10 levels, and +1d8 damage at level 5 and every 5 levels thereafter."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
