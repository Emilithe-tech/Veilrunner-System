<aside class="vr-hud-party {{#unless partyOpen}}is-collapsed{{/unless}}" aria-label="Party status">
  <header><i class="fa-solid fa-people-group"></i><span>Party</span><em>{{panState}}</em><button type="button" data-action="toggleParty" aria-label="{{#if partyOpen}}Close{{else}}Open{{/if}} party list" title="{{#if partyOpen}}Close{{else}}Open{{/if}} party list"><i class="fa-solid fa-chevron-{{#if partyOpen}}down{{else}}up{{/if}}" aria-hidden="true"></i></button></header>
  {{#if partyOpen}}
  <div class="vr-hud-party-list">
    {{#each party as |member|}}
      <article class="vr-hud-party-card fidelity-{{member.fidelity}}">
        <div class="vr-hud-party-portrait"><img src="{{member.img}}" alt="" /></div>
        <div><strong>{{member.name}}</strong>
          <div class="vr-hud-party-resources">
            {{#each member.resources as |resource|}}
              {{#if resource.visible}}
                <span class="resource-{{resource.key}}" title="{{resource.key}}">
                  <b>{{resource.key}}</b>
                  {{#if resource.exact}}<i style="--value:{{resource.percent}}%"></i><em>{{resource.value}}/{{resource.max}}</em>{{else}}<i style="--value:{{resource.percent}}%"></i><em>{{resource.state}}</em>{{/if}}
                </span>
              {{/if}}
            {{/each}}
          </div>
          {{#if member.conditions.length}}<div class="vr-hud-condition-icons">{{#each member.conditions as |condition|}}<img src="{{condition.img}}" title="{{condition.name}}" alt="{{condition.name}}" />{{/each}}</div>{{/if}}
        </div>
      </article>
    {{else}}
      <p class="vr-hud-empty">No party telemetry.</p>
    {{/each}}
  </div>
  {{/if}}
</aside>
