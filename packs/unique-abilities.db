{"_id":"3b7435b9ce6aabc9","name":"Divine Veil","type":"ability","img":"icons/svg/upgrade.svg","system":{"definitionId":"veilrunner.unique-abilities.cleric.adjudicator.divine-veil","intents":["action-provider"],"providedActionIds":[],"featured":false,"category":"actions","actions":0,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"recharge":"","summary":"","description":"<p>Become immune to non-lethal physical damage for 1d4 rounds. After it fades, roll 2d10 days before your deity answers again.</p>","traits":["ability"]},"effects":[],"folder":null,"sort":500000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Cleric","discipline":"Adjudicator","sourceAbilityName":"Divine Veil","sourceType":"Ability","rulesText":"Become immune to non-lethal physical damage for 1d4 rounds. After it fades, roll 2d10 days before your deity answers again."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
