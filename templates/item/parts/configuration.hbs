{{#if magazine}}<section class="vr-item-panel"><h2 class="section-heading">Installed components</h2><div class="vr-item-card-grid">
  <article class="vr-item-config-card"><h3>Magazine</h3><div class="vr-item-feature">{{#if magazine.img}}<img src="{{magazine.img}}" alt="" />{{else}}<i class="fa-solid fa-grip-lines-vertical vr-item-feature-icon" aria-hidden="true"></i>{{/if}}<div><strong>{{magazine.name}}</strong>{{#if magazine.installed}}<p>{{magazine.rounds}} / {{magazine.capacity}} rounds</p>{{/if}}</div></div>
    {{#if canConfigure}}<div class="vr-item-buttons">{{#if magazine.installed}}<button type="button" data-sheet-action="firearm" data-operation="reload">Reload</button><button type="button" class="vr-item-remove" data-sheet-action="firearm" data-operation="unload">Remove</button>{{else}}<button type="button" data-sheet-action="firearm" data-operation="load">Install</button>{{/if}}</div>{{/if}}
  </article>
  {{#if ammoName}}<article class="vr-item-config-card"><h3>Ammunition</h3><div class="vr-item-feature"><i class="fa-solid fa-bars vr-item-feature-icon" aria-hidden="true"></i><strong>{{ammoName}}</strong></div></article>{{/if}}
</div></section>{{/if}}
{{#if internalAmmo}}<section class="vr-item-panel"><h2 class="section-heading">Ammunition</h2><div class="vr-item-config-card"><h3>{{internalAmmo.name}}</h3><p>{{internalAmmo.rounds}} / {{internalAmmo.capacity}} rounds</p>{{#if canConfigure}}<div class="vr-item-buttons"><button type="button" data-sheet-action="firearm" data-operation="reload">Reload</button><button type="button" class="vr-item-remove" data-sheet-action="firearm" data-operation="unload">Unload</button></div>{{/if}}</div></section>{{/if}}
{{#each configurations}}<section class="vr-item-panel" data-configuration-id="{{id}}"><div class="vr-item-heading-row"><h2 class="section-heading">{{label}}</h2>{{#if hasSelections}}<button type="button" data-sheet-action="resetConfiguration">Reset choices</button>{{/if}}</div>
  <p class="vr-item-hint">{{#if preview}}Preview these choices.{{else}}Choices are remembered for this item's Action HUD.{{/if}}</p>
  <div class="vr-item-card-grid">{{#each choices}}<label class="vr-item-config-card"><span class="vr-item-choice-title"><i class="fa-solid {{icon}}" aria-hidden="true"></i>{{label}}</span>{{#if description}}<span class="vr-item-hint">{{description}}</span>{{/if}}
    {{#if select}}<select data-configuration="{{key}}" aria-label="{{label}}">{{#each options}}<option value="{{value}}" {{#if minRank}}data-min-rank="{{minRank}}"{{/if}} {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
    {{#if number}}<input type="number" data-configuration="{{key}}" {{#if enableKey}}data-enable-key="{{enableKey}}"{{/if}} value="{{value}}" min="{{min}}" max="{{max}}" step="1" aria-label="{{label}}" />{{/if}}
    {{#if toggle}}<input type="checkbox" data-configuration="{{key}}" {{#if checked}}checked{{/if}} aria-label="{{label}}" />{{/if}}
  </label>{{/each}}</div>
  {{#if comparison.length}}<h2 class="section-heading vr-item-subheading">Current loadout <small>Compare to base</small></h2><div class="vr-item-comparison">{{#each comparison}}<div><span>{{label}}</span><p>{{before}} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i> <b class="{{#if changed}}changed{{/if}}">{{after}}</b></p>{{#if change}}<strong class="changed">{{change}}</strong>{{/if}}</div>{{/each}}</div>{{/if}}
  {{#if breakdown.length}}<details class="vr-item-calculation"><summary>Configuration effects</summary>{{> "systems/veilrunner/templates/item/parts/rows.hbs" rows=breakdown}}</details>{{/if}}
</section>{{else}}{{#unless magazine}}{{#unless internalAmmo}}<p class="vr-item-empty">This item has no configurable choices.</p>{{/unless}}{{/unless}}{{/each}}
