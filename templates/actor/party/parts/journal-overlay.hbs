<section class="vr-party-v2-journal-overlay {{#if partyJournalClosing}}is-closing{{/if}}" aria-label="{{partyJournalEntry.name}}"><header><strong>{{partyJournalEntry.name}}</strong>{{> "systems/veilrunner/templates/actor/party/parts/journal-close-button.hbs"}}</header><div class="vr-party-v2-journal-pages">{{#each partyJournalEntry.pages as |page|}}<article class="vr-party-v2-journal-page"><h3>{{page.name}}</h3>{{#if (eq page.type "text")}}<div class="journal-page-content">{{{page.content}}}</div>{{else}}<p>{{localize 'VEILRUNNER.UnsupportedJournalPage'}}</p>{{/if}}</article>{{/each}}</div></section>
