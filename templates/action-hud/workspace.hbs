<main class="vr-hud-workspace vr-hud-panel" aria-label="Combat actions">
  {{#if workspaceComposer}}
    <form class="vr-hud-composer">
      <header><button type="button" data-action="setWorkspace" data-workspace="normal"><i class="fa-solid fa-chevron-left"></i> Back</button><div>{{#if composer.action.weaponComposer}}<strong>{{composer.action.weaponComposer.weaponName}}</strong><span>{{composer.action.weaponComposer.weaponType}} Weapon</span>{{else}}<strong>{{composer.action.name}}</strong><span>{{composer.action.domain}} · {{composer.action.actionType}}</span>{{/if}}</div>{{#if composer.action.weaponComposer}}<em><i class="fa-solid fa-bullets"></i> {{composer.action.weaponComposer.ammoCurrent}} / {{composer.action.weaponComposer.ammoCapacity}}</em>{{else if composer.action.mapPenalty}}<em>MAP {{composer.action.mapPenalty}}</em>{{/if}}</header>
      {{#if composer.action.weaponComposer}}
      <div class="vr-hud-weapon-composer">
        <section class="vr-hud-fire-modes"><h3>Fire Mode</h3><div>{{#each composer.action.weaponComposer.modes as |mode|}}<label class="{{#if mode.selected}}selected{{/if}}"><input data-composer-input type="radio" name="fireMode" value="{{mode.id}}" {{#if mode.selected}}checked{{/if}} /><strong>{{mode.label}}</strong><span>{{mode.actions}} AP · {{mode.ammoCost}} Ammo</span></label>{{/each}}</div></section>
        <section class="vr-hud-weapon-stats"><h3>Weapon Stats</h3><div><span><small>Attack</small><strong>{{composer.action.weaponComposer.attackFormula}}{{#if composer.action.attackModifier}} + {{composer.action.attackModifier}}{{/if}}</strong></span><span><small>Damage</small><strong>{{#if composer.action.damageFormula}}{{composer.action.damageFormula}}{{else}}{{composer.action.weaponComposer.damageFormula}}{{/if}}{{#if composer.action.damageModifier}} + {{composer.action.damageModifier}}{{/if}}</strong></span><span><small>Type</small><strong>{{composer.action.weaponComposer.damageType}}</strong></span><span><small>AP Cost</small><strong>{{composer.action.actionCount}}</strong></span><span><small>Ammo</small><strong>{{composer.action.ammoCost}}</strong></span><span><small>Range</small><strong>{{composer.action.range}}</strong></span><span><small>MAP</small><strong>{{#if composer.action.mapPenalty}}{{composer.action.mapPenalty}}{{else}}0{{/if}}</strong></span></div></section>
        {{#if composer.action.weaponComposer.options.length}}<section class="vr-hud-weapon-options"><h3>Options</h3><div>{{#each composer.action.weaponComposer.options as |option|}}<label title="{{option.description}}"><input data-composer-input type="checkbox" name="weaponOption:{{option.id}}" value="1" {{#if option.selected}}checked{{/if}} /><span><strong>{{option.label}}</strong>{{#if option.description}}<small>{{option.description}}</small>{{/if}}</span></label>{{/each}}</div></section>{{/if}}
        <section class="vr-hud-weapon-outcome"><h3>Projected Outcome</h3><div><span><small>Attack Formula</small><strong>{{composer.action.weaponComposer.attackFormula}}</strong></span><span><small>Damage</small><strong>{{#if composer.action.damageFormula}}{{composer.action.damageFormula}}{{else}}{{composer.action.weaponComposer.damageFormula}}{{/if}}</strong></span><span><small>Damage Maximum</small><strong>{{composer.action.weaponComposer.damageMaximum}}</strong></span><span><small>Ammunition</small><strong>{{composer.action.weaponComposer.ammoCurrent}} / {{composer.action.weaponComposer.ammoCapacity}}</strong></span></div>{{#if composer.action.errors.length}}<p>{{lookup composer.action.errors 0}}</p>{{/if}}</section>
      </div>
      <button class="vr-hud-primary" type="button" data-action="executeComposer" {{#unless composer.action.availability.available}}disabled title="{{composer.action.availability.reason}}"{{/unless}}><i class="fa-solid fa-crosshairs"></i> Fire</button>
      {{else}}
      <div class="vr-hud-composer-grid">
        <section>
          <h3>Configuration</h3>
          {{#each composer.action.composer as |field|}}
            <label><span>{{field.label}}</span>
              {{#if (eq field.type "rank")}}<input data-composer-input type="number" name="{{field.key}}" min="{{field.min}}" max="{{field.max}}" value="{{lookup ../composer.selections field.key}}" />
              {{else if (eq field.type "toggle")}}<input data-composer-input type="checkbox" name="{{field.key}}" value="1" {{checked (lookup ../composer.selections field.key)}} />
              {{else}}<select data-composer-input name="{{field.key}}">{{#each field.choices as |choice|}}<option value="{{choice}}" {{#if (eq choice (lookup ../../composer.selections ../key))}}selected{{/if}}>{{choice}}</option>{{/each}}</select>{{/if}}
            </label>
          {{/each}}
          {{#if composer.action.rankScaling.enabled}}<label><span>Rank</span><input data-composer-input type="number" name="rank" min="{{composer.action.rankScaling.min}}" max="{{composer.action.rankScaling.max}}" value="{{lookup composer.selections 'rank'}}" /></label>{{/if}}
          {{#each composer.action.enhancements as |enhancement|}}<label><span>{{enhancement.label}}</span><input data-composer-input type="number" name="enhancement:{{enhancement.id}}" min="0" max="{{enhancement.maxStacks}}" value="{{lookup ../composer.selections (concat 'enhancement:' enhancement.id)}}" /></label>{{/each}}
        </section>
        <section><h3>Projected Cost</h3>{{#each composer.preview as |entry|}}<div class="vr-hud-preview"><span>{{entry.key}}</span><strong>{{entry.before}} → {{entry.after}}</strong><em>−{{entry.cost}}</em></div>{{else}}<p>No projected resource cost.</p>{{/each}}<details><summary>Calculation</summary><p>Source, traits, governing attribute, active effects, target state, and selected options are revalidated at execution.</p></details></section>
      </div>
      <button class="vr-hud-primary" type="button" data-action="executeComposer" {{#unless composer.action.availability.available}}disabled title="{{composer.action.availability.reason}}"{{/unless}}>Execute</button>
      {{/if}}
    </form>
  {{else if workspaceWeapons}}
    <header class="vr-hud-workspace-header"><button type="button" data-action="setWorkspace" data-workspace="normal"><i class="fa-solid fa-chevron-left"></i> Back</button><strong>Switch Weapon</strong><input data-weapon-search type="search" value="{{weaponQuery}}" placeholder="Name, category, trait…" /></header>
    <nav class="vr-hud-weapon-filters"><button type="button" data-action="setWeaponFilter" data-weapon-filter="all" class="{{#if (eq weaponFilter 'all')}}active{{/if}}">All</button><button type="button" data-action="setWeaponFilter" data-weapon-filter="recent" class="{{#if (eq weaponFilter 'recent')}}active{{/if}}">Recent</button><button type="button" data-action="setWeaponFilter" data-weapon-filter="favorites" class="{{#if (eq weaponFilter 'favorites')}}active{{/if}}">Favorites</button>{{#each weaponFamilies as |family|}}<button type="button" data-action="setWeaponFilter" data-weapon-filter="{{family.id}}" class="{{#if (eq family.id ../weaponFilter)}}active{{/if}}">{{family.label}}</button>{{/each}}</nav>
    <div class="vr-hud-weapon-grid">{{#each weapons as |weapon|}}<button type="button" data-action="equipWeapon" data-weapon-id="{{weapon.id}}" class="{{#if weapon.equipped}}equipped{{/if}}"><img src="{{weapon.img}}" alt="" /><span>{{weapon.name}}</span><em>{{weapon.category}}{{#if weapon.traits.length}} · {{weapon.traits}}{{/if}}</em>{{#if weapon.equipped}}<b>Equipped</b>{{else if weapon.favorite}}<b>Favorite</b>{{else if weapon.recent}}<b>Recent</b>{{/if}}</button>{{else}}<p class="vr-hud-empty">No matching weapons.</p>{{/each}}</div>
  {{else if workspaceSaves}}
    <header class="vr-hud-workspace-header"><button type="button" data-action="setWorkspace" data-workspace="normal"><i class="fa-solid fa-chevron-left"></i> Back</button><strong>{{#if requestedSave}}{{requestedSave.label}}{{else}}Saving Throws{{/if}}</strong>{{#if requestedSave.dc}}<em>DC {{requestedSave.dc}}</em>{{/if}}</header>
    <div class="vr-hud-save-grid">{{#each saves as |save|}}<button type="button" data-action="rollSave" data-save="{{save.key}}"><span>{{save.label}}</span><strong>+{{save.value}}</strong></button>{{/each}}</div>
  {{else if workspaceAsset}}
    <header class="vr-hud-workspace-header"><button type="button" data-action="setWorkspace" data-workspace="normal"><i class="fa-solid fa-chevron-left"></i> Back</button><strong>Asset Control</strong></header>
    {{#each assets as |asset|}}{{#if (eq asset.uuid ../hud.selectedAssetUuid)}}<section class="vr-hud-asset-context"><img src="{{asset.img}}" alt="" /><div><h3>{{asset.name}}</h3><span>{{asset.kind}}</span></div></section><div class="vr-hud-action-grid">{{#each asset.actions as |action|}}<button type="button" data-action="useAction" data-action-id="{{action.id}}"><img src="{{action.img}}" alt="" /><span>{{action.name}}</span></button>{{else}}<p>No authored asset actions.</p>{{/each}}</div>{{/if}}{{/each}}
  {{else if workspaceLibrary}}
    <header class="vr-hud-workspace-header"><button type="button" data-action="setWorkspace" data-workspace="normal"><i class="fa-solid fa-chevron-left"></i> Back</button><nav>{{#each domains as |domain|}}<button type="button" data-action="setDomain" data-domain="{{domain}}" class="{{#if (eq domain ../activeDomain)}}active{{/if}}">{{domain}}</button>{{/each}}</nav><input data-hud-search type="search" value="{{query}}" placeholder="Search actions, traits, source…" /></header>
    <div class="vr-hud-action-grid">{{#each actions as |action|}}<article class="vr-hud-action-card state-{{action.availability.state}}"><button type="button" data-action="useAction" data-action-id="{{action.id}}" {{#unless action.availability.available}}disabled title="{{action.availability.reason}}"{{/unless}}><img src="{{action.img}}" alt="" /><span>{{action.name}}</span><em>{{action.actionCount}} AP · {{action.category}}</em>{{#if action.mapPenalty}}<b>MAP {{action.mapPenalty}}</b>{{/if}}</button><button class="vr-hud-pin" type="button" data-action="pinAction" data-action-id="{{action.id}}" aria-label="Pin {{action.name}}"><i class="fa-solid fa-thumbtack"></i></button></article>{{else}}<p class="vr-hud-empty">No matching actions.</p>{{/each}}</div>
  {{else}}
    <section class="vr-hud-equipped"><header><span>Equipped</span><button type="button" data-action="switchWeapon"><i class="fa-solid fa-repeat"></i> Switch</button></header><div>{{#each equipped as |item|}}<button type="button" data-action="openEquipped" data-item-id="{{item.id}}"><img src="{{item.img}}" alt="" /><span>{{item.name}}</span><em>{{item.type}}</em></button>{{else}}<button type="button" data-action="switchWeapon"><i class="fa-solid fa-plus"></i><span>Equip an item</span></button>{{/each}}</div></section>
    <section class="vr-hud-deck-section"><header><span>Pinned</span></header><div class="vr-hud-quick-row">{{#each pinned as |action|}}<button type="button" data-action="useAction" data-action-id="{{action.id}}" {{#unless action.availability.available}}disabled title="{{action.availability.reason}}"{{/unless}}><img src="{{action.img}}" alt="" /><span>{{action.name}}</span></button>{{else}}<span class="vr-hud-empty-slot">Pin actions from a library.</span>{{/each}}</div></section>
    <section class="vr-hud-deck-section"><header><span>Context</span></header><div class="vr-hud-quick-row">{{#each context as |action|}}<button type="button" data-action="useAction" data-action-id="{{action.id}}" {{#unless action.availability.available}}disabled title="{{action.availability.reason}}"{{/unless}}><img src="{{action.img}}" alt="" /><span>{{action.name}}</span></button>{{else}}<span class="vr-hud-empty-slot">No contextual action.</span>{{/each}}</div></section>
    {{#if recent.length}}<section class="vr-hud-deck-section recent"><header><span>Recent</span></header><div class="vr-hud-quick-row">{{#each recent as |action|}}<button type="button" data-action="useAction" data-action-id="{{action.id}}"><img src="{{action.img}}" alt="" /><span>{{action.name}}</span></button>{{/each}}</div></section>{{/if}}
    <nav class="vr-hud-domain-nav">{{#each domains as |domain|}}{{#if (eq domain 'assets')}}{{#each ../assets as |asset|}}<button type="button" data-action="selectAsset" data-asset-uuid="{{asset.uuid}}"><i class="fa-solid fa-paw"></i>{{asset.name}}</button>{{/each}}{{else}}<button type="button" data-action="setDomain" data-domain="{{domain}}">{{domain}}</button>{{/if}}{{/each}}<button type="button" data-action="setDomain" data-domain=""><i class="fa-solid fa-magnifying-glass"></i> Search</button></nav>
  {{/if}}
</main>
