    "Settings": {
      "Sections": {
        "datapad": "Datapad",
        "general": "General Settings"
      },
      "combatCarouselEnabled": {
        "Name": "Combat Carousel",
        "Hint": "Show the separate top-of-screen combat carousel while combat is active."
      },
      "combatCarouselPortraitShape": {
        "Name": "Combat Carousel Portrait Shape",
        "Hint": "Choose the portrait shape used by combat carousel cards.",
        "Choices": {
          "circle": "Circle",
          "rounded": "Rounded",
          "square": "Square"
        }
      },
      "combatCarouselPortraitSize": {
        "Name": "Combat Carousel Portrait Size",
        "Hint": "Choose the standard portrait size used by combat carousel cards.",
        "Choices": {
          "small": "Small",
          "medium": "Medium",
          "large": "Large",
          "xl": "XL",
          "xxl": "XXL"
        }
      },
      "combatCarouselTextSize": {
        "Name": "Combat Carousel Text Size",
        "Hint": "Set the text size in pixels."
      },
      "combatCarouselShowResourceNumbers": {
        "Name": "Combat Carousel Resource Numbers",
        "Hint": "Show health, armor, barrier, and shield numbers when the viewer has access."
      },
      "combatCarouselRevealPlayerNumbers": {
        "Name": "Reveal Carousel Numbers to Players",
        "Hint": "Allow players to see non-owned combatant numbers. Off by default so PAN details stay hidden until access is earned."
      },
      "combatCarouselShowResourceBars": {
        "Name": "Combat Carousel Resource Bars",
        "Hint": "Show bars for health, armor, barrier, and shields."
      },
      "combatCarouselResourceBarsGmOnly": {
        "Name": "Resource Bars GM Only",
        "Hint": "Only GMs can see Combat Carousel resource bars when this is enabled."
      },
      "combatCarouselResourceBarVisibility": {
        "Name": "Resource Bars Visibility",
        "Hint": "Choose when Combat Carousel resource bars are visible on this client.",
        "Choices": {
          "hover": "Hover",
          "always": "Always On",
          "off": "Always Off"
        }
      },
      "combatCarouselActivePhaseOnly": {
        "Name": "Combat Carousel: Phase View",
        "Hint": "In phase initiative, choose whether to show every phase, only the active phase, or the active and upcoming phases.",
        "Choices": {
          "all": "All Phases",
          "active": "Active Phase Only",
          "hybrid": "Active Phase + Next Turn"
        }
      },
      "combatCarouselGmCompact": {
        "Name": "Combat Carousel: Compact GM View",
        "Hint": "Use a smaller, denser carousel on this GM client. This does not affect players."
      },
      "combatCarouselHideDead": {
        "Name": "Combat Carousel: Hide Dead Actors",
        "Hint": "Hide defeated or zero-health combatants from this client's carousel."
      },
      "combatCarouselLocked": {
        "Name": "Combat Carousel Locked",
        "Hint": "Stores whether this client's Combat Carousel can be dragged."
      },
      "combatCarouselPosition": {
        "Name": "Combat Carousel Position",
        "Hint": "Stores this client's Combat Carousel screen position."
      },
      "allowPlayerDatapad": {
        "Name": "Allow Player Datapad",
        "Hint": "Let non-GM users open the campaign Datapad from the Journal directory, hero sheet, or J keybinding."
      },
      "createDatapadFolders": {
        "Name": "Create Datapad Folders",
        "Hint": "Automatically create and maintain the Journal folder structure used by the Veilrunner Datapad."
      },
      "initiativeMode": {
        "Name": "Initiative Mode",
        "Hint": "Choose how combat turns are organized for this world.",
        "Choices": {
          "traditional": "Traditional Initiative",
          "phases": "Initiative Phases",
          "block": "Block Initiative"
        }
      },
      "initiativeBands": {
        "Name": "Initiative Bands",
        "Hint": "Stores the GM's current initiative phase names and breakpoints."
      },
      "initiativeNeutralPhaseEnabled": {
        "Name": "Use Neutral Initiative Phase",
        "Hint": "Place combatants without rolled initiative into a Neutral Phase at the end of the carousel."
      },
      "initiativeBandsPanelEnabled": {
        "Name": "Show Initiative Bands Panel",
        "Hint": "Show the movable Initiative Bands panel during initiative phase combat."
      },
      "initiativeBandsPanelLocked": {
        "Name": "Initiative Bands Panel Locked",
        "Hint": "Stores whether this client's Initiative Bands panel can be dragged."
      },
      "initiativeBandsPanelPosition": {
        "Name": "Initiative Bands Panel Position",
        "Hint": "Stores this client's Initiative Bands panel screen position."
      },
      "defaultQuestObjectiveVisibility": {
        "Name": "Default Quest Objective Visibility",
        "Hint": "Choose what quest objective visibility means when a quest is set to Default.",
        "Choices": {
          "observers": "Visible to observers",
          "gm": "GM only"
        }
      },
      "DatapadDisabled": "The Player Datapad is disabled for players in this world."
    },
