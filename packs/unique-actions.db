{"_id":"6b6e34971363a6f9","name":"Improvised Toxin Grenade","type":"action","img":"icons/svg/sword.svg","system":{"definitionId":"veilrunner.unique-actions.field-technician.chemist.improvised-toxin-grenade","intents":["action-provider"],"providedActionIds":[],"activationKind":"action","actionType":"standard","category":"actions","favorite":false,"actions":2,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"cost":"","rollFormula":"","selector":"action","requiredItemTypes":[],"requiredItemTraits":[],"requiredDefinitionIds":[],"requiredItemIntents":[],"requiresTarget":false,"requiredEffects":[],"requiredTargetEffects":[],"composer":[],"summary":"","description":"<p>Create an Improved Toxin Grenade during an excursion and roll 1d10 for quality. Twice per Field Recovery.</p>","traits":["action"]},"effects":[],"folder":null,"sort":300000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Field Technician","discipline":"Chemist","sourceAbilityName":"Improvised Toxin Grenade","sourceType":"Action >>","rulesText":"Create an Improved Toxin Grenade during an excursion and roll 1d10 for quality. Twice per Field Recovery."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"8b02621f234aafb6","name":"Disabling Holshi Shatter","type":"action","img":"icons/svg/sword.svg","system":{"definitionId":"veilrunner.unique-actions.duelist.samurai.disabling-holshi-shatter","intents":["action-provider"],"providedActionIds":[],"activationKind":"action","actionType":"standard","category":"actions","favorite":false,"actions":2,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"cost":"","rollFormula":"","selector":"action","requiredItemTypes":[],"requiredItemTraits":[],"requiredDefinitionIds":[],"requiredItemIntents":[],"requiresTarget":false,"requiredEffects":[],"requiredTargetEffects":[],"composer":[],"summary":"","description":"<p>With a short blade, strike a Holtzman shield. Outcomes range from no effect to bypassing and disabling the shield for 1d4 or 2d4 turns. Three uses per long rest.</p>","traits":["action"]},"effects":[],"folder":null,"sort":200000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Duelist","discipline":"Samurai","sourceAbilityName":"Disabling Holshi Shatter","sourceType":"Action >>","rulesText":"With a short blade, strike a Holtzman shield. Outcomes range from no effect to bypassing and disabling the shield for 1d4 or 2d4 turns. Three uses per long rest."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"8cb99af7a7f7a162","name":"Successive Arrows","type":"action","img":"icons/svg/sword.svg","system":{"definitionId":"veilrunner.unique-actions.marksman.ranger.successive-arrows","intents":["action-provider"],"providedActionIds":[],"activationKind":"action","actionType":"standard","category":"actions","favorite":false,"actions":2,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"cost":"","rollFormula":"","selector":"action","requiredItemTypes":[],"requiredItemTraits":[],"requiredDefinitionIds":[],"requiredItemIntents":[],"requiresTarget":false,"requiredEffects":[],"requiredTargetEffects":[],"composer":[],"summary":"","description":"<p>With a bow equipped, fire three declared arrows. Attacks count toward attack penalty, but the penalty applies after the action completes. Three uses per Field Recovery.</p>","traits":["action"]},"effects":[],"folder":null,"sort":500000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Marksman","discipline":"Ranger","sourceAbilityName":"Successive Arrows","sourceType":"Action >>","rulesText":"With a bow equipped, fire three declared arrows. Attacks count toward attack penalty, but the penalty applies after the action completes. Three uses per Field Recovery."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"cde287a384ebe249","name":"Pray","type":"action","img":"icons/svg/sword.svg","system":{"definitionId":"veilrunner.unique-actions.cleric.priest.pray","intents":["action-provider"],"providedActionIds":[],"activationKind":"action","actionType":"standard","category":"actions","favorite":false,"actions":2,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"cost":"","rollFormula":"","selector":"action","requiredItemTypes":[],"requiredItemTraits":[],"requiredDefinitionIds":[],"requiredItemIntents":[],"requiresTarget":false,"requiredEffects":[],"requiredTargetEffects":[],"composer":[],"summary":"","description":"<p>Chant in prayer, consuming 10 stamina each combat round. Heal creatures within 10m for 2d8 + Wisdom HP at the end of your turn; undead instead take vitality damage with a Wisdom save.</p>","traits":["action"]},"effects":[],"folder":null,"sort":700000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Cleric","discipline":"Priest","sourceAbilityName":"Pray","sourceType":"Sustained Action >>","rulesText":"Chant in prayer, consuming 10 stamina each combat round. Heal creatures within 10m for 2d8 + Wisdom HP at the end of your turn; undead instead take vitality damage with a Wisdom save."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
{"_id":"d0c450fed7c4f321","name":"Overriding Dominance","type":"action","img":"icons/svg/sword.svg","system":{"definitionId":"veilrunner.unique-actions.field-technician.beast-tamer.overriding-dominance","intents":["action-provider"],"providedActionIds":[],"activationKind":"action","actionType":"standard","category":"actions","favorite":false,"actions":2,"damageType":"","currentLevel":1,"maxLevel":1,"damageDice":0,"damageDie":6,"damageLevelInterval":3,"cost":"","rollFormula":"","selector":"action","requiredItemTypes":[],"requiredItemTraits":[],"requiredDefinitionIds":[],"requiredItemIntents":[],"requiresTarget":false,"requiredEffects":[],"requiredTargetEffects":[],"composer":[],"summary":"","description":"<p>Roll Train Creature + Charisma against a hostile creature. Outcomes range from no effect to pacified, allied, or tamed for the encounter.</p>","traits":["action"]},"effects":[],"folder":null,"sort":400000,"ownership":{"default":0},"flags":{"veilrunner":{"uniqueAbility":true,"profession":"Field Technician","discipline":"Beast Tamer","sourceAbilityName":"Overriding Dominance","sourceType":"Action >>","rulesText":"Roll Train Creature + Charisma against a hostile creature. Outcomes range from no effect to pacified, allied, or tamed for the encounter."}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.16","coreVersion":"14.365"}}
