{"_id":"I8YLQBEtZw5vEqrX","name":"Druid - Cultivator","type":"profession","img":"icons/svg/book.svg","system":{"archetype":"Magic","profession":"Druid","discipline":"Cultivator","quote":"","primaryWeapon":"Staff","primaryAttributes":["Intelligence","Willpower"],"bonusAttributes":["Agility","Intelligence"],"bonusSkill":"Reading of Roots","persona":["Empathetic","Collectivist"],"pageImage":"assets/img/professions/druid.png","sourcePage":"15","description":"<figure class=\"vr-profession-pdf-page\"><img src=\"systems/veilrunner/assets/img/professions/druid.png\" alt=\"Druid - Cultivator PDF page 15\" /></figure>"},"effects":[],"folder":null,"sort":2600000,"ownership":{"default":0},"flags":{"veilrunner":{"source":"Veilrunner 2026.07.30.pdf","professionSummary":"Druids commune with nature and stabilize Aether disrupted by corporations and reckless magic users.","disciplineSummary":"An arbormancy caster who uses flora to control movement, cause conditions, and defend enclaves.","abilities":[{"name":"Resplendent Flora","type":"Ability","text":"When flora is available, gain +10 to attack rolls for floral abilities and spells, plus 1d6 floral damage for every five character levels. Once per long rest."},{"name":"Green Thumb","type":"Trait","text":"When casting a spell with the floral trait, gain +1 to the attack roll for every five character levels."}]}},"_stats":{"systemId":"Veilrunner","systemVersion":"0.0.9","coreVersion":"14.365","createdTime":1785974400000,"modifiedTime":1785974400000,"lastModifiedBy":null}}
