<label class="vr-rel-field">{{label}}
  {{#if isAudience}}<select name="{{name}}" multiple size="4">{{#each audience}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><small>No selection keeps this record private.</small>
  {{else if isSelect}}<select name="{{name}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
  {{else if isTextarea}}<textarea name="{{name}}" rows="3">{{value}}</textarea>
  {{else if isCheckbox}}<input type="checkbox" name="{{name}}" {{#if checked}}checked{{/if}}>
  {{else}}<input type="{{inputType}}" name="{{name}}" value="{{value}}" step="any">{{/if}}
</label>
